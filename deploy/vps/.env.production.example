# Bản ghi A phải trỏ về IP VPS TRƯỚC khi chạy deploy/vps/init-tls.sh.
# Let's Encrypt không cấp chứng chỉ cho IP trần, bắt buộc phải có tên miền.
APP_DOMAIN=fleet.example.com
COMPOSE_PROJECT_NAME=safefleet

# Email nhận cảnh báo chứng chỉ sắp hết hạn từ Let's Encrypt.
LETSENCRYPT_EMAIL=ops@example.com
# Đặt 1 khi thử nghiệm để tránh chạm hạn mức 5 lần/giờ của Let's Encrypt.
# Chứng chỉ staging KHÔNG được trình duyệt và Android tin.
LETSENCRYPT_STAGING=0

# CI đẩy ba image backend/frontend/ai vào namespace này.
IMAGE_REGISTRY_PREFIX=ghcr.io/your-github-owner/safefleet
IMAGE_TAG=replace-with-git-commit-sha

POSTGRES_DB=safefleet
POSTGRES_USER=safefleet
POSTGRES_PASSWORD=replace-with-a-long-random-password
INFRA_BIND_ADDRESS=127.0.0.1
PRODUCTION_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=3000

JWT_SECRET=replace-with-at-least-48-random-characters
JWT_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=30
CORS_ALLOWED_ORIGINS=https://fleet.example.com
OPENAPI_PUBLIC_ENABLED=false
SEED_ENABLED=false
HANOI_DEMO_DATA_ENABLED=false
APP_LOG_LEVEL=INFO

AI_SERVICE_ENABLED=true
AI_SERVICE_URL=http://ai-service:8000
AI_INTERNAL_TOKEN=replace-with-an-independent-long-random-token
AGENT_ENCRYPTION_SECRET=replace-with-an-independent-long-random-secret
OPENAI_ENABLED=true
OPENAI_API_KEY=replace-on-vps-only
AGENT_MAX_STEPS=6
RAG_ENABLED=true
RAG_EMBEDDING_MODEL=intfloat/multilingual-e5-small
MCP_TIMEOUT_SECONDS=60

MINIO_ROOT_USER=replace-with-private-minio-user
MINIO_ROOT_PASSWORD=replace-with-a-long-random-password
MINIO_BUCKET=safefleet-evidence
EVIDENCE_STORAGE_PROVIDER=minio
EVIDENCE_MAX_SIZE_BYTES=8388608

FCM_ENABLED=true
FCM_CREDENTIALS_HOST_PATH=/opt/safefleet/secrets/firebase-service-account.json
PUSH_DISPATCH_INTERVAL_MS=30000
PUSH_MAX_ATTEMPTS=6

PHOTON_URL=https://photon.komoot.io/api/
VALHALLA_URL=http://valhalla:8002
VALHALLA_COSTING=truck
VALHALLA_TILE_URLS=https://download.geofabrik.de/asia/vietnam-latest.osm.pbf
VALHALLA_SERVER_THREADS=1
VALHALLA_FORCE_REBUILD=False
VALHALLA_BUILD_ELEVATION=False
OSRM_URL=https://router.project-osrm.org/route/v1/driving
ALLOW_DETERMINISTIC_ROUTING_FALLBACK=false

NEXT_PUBLIC_MAP_TILE_URL=https://a.basemaps.cartocdn.com/light_all/{z}/{x}/{y}.png
