# Chỉ ${APP_DOMAIN} được thay ở đây; NGINX_ENVSUBST_FILTER giới hạn envsubst
# theo tiền tố APP_ nên mọi biến của nginx như $host, $remote_addr giữ nguyên.

# Cổng 80 chỉ làm hai việc: trả lời thử thách ACME và đẩy phần còn lại sang HTTPS.
server {
    listen      80;
    listen      [::]:80;
    server_name ${APP_DOMAIN};

    # Certbot ghi thử thách vào webroot dùng chung với container nginx.
    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
    }

    # Healthcheck của container hỏi qua HTTP loopback, không đi vòng qua TLS và
    # không phụ thuộc chứng chỉ đã có hay chưa.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen              443 ssl;
    listen              [::]:443 ssl;
    http2               on;
    server_name         ${APP_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${APP_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${APP_DOMAIN}/privkey.pem;

    ssl_protocols             TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_ciphers               ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_session_cache         shared:SafeFleetTLS:10m;
    ssl_session_timeout       1d;
    ssl_session_tickets       off;
    ssl_stapling              on;
    ssl_stapling_verify       on;
    resolver                  127.0.0.11 valid=60s;
    resolver_timeout          5s;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options    "nosniff" always;
    add_header X-Frame-Options           "DENY" always;
    add_header Referrer-Policy           "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy        "camera=(), microphone=(), payment=(), usb=()" always;

    # CSP để ở chế độ chỉ báo cáo. Web quản lý là Next.js có script nội tuyến và
    # tải tile bản đồ từ CDN ngoài; bật chặn ngay mà chưa soi báo cáo sẽ làm
    # trắng trang. Xem log vi phạm rồi mới đổi sang Content-Security-Policy.
    add_header Content-Security-Policy-Report-Only
        "default-src 'self'; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; connect-src 'self' https: wss:; font-src 'self' data: https:; frame-ancestors 'none'; base-uri 'self'" always;

    limit_conn conn_zone 64;

    # Trang đăng nhập bị dò mật khẩu nhiều nhất nên có hạn mức riêng.
    location = /api/v1/auth/login {
        limit_req zone=login_zone burst=8 nodelay;
        proxy_pass http://backend:8080;
    }

    location /api/ {
        limit_req zone=api_zone burst=60 nodelay;
        proxy_pass http://backend:8080;

        # Định tuyến và tải bằng chứng có thể lâu hơn một request thường.
        proxy_connect_timeout 10s;
        proxy_send_timeout    120s;
        proxy_read_timeout    120s;
    }

    # STOMP/WebSocket cho bản đồ thời gian thực.
    location /ws-native {
        proxy_pass http://backend:8080;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        # Giữ kết nối mở cả ca lái; nếu ngắt sớm bản đồ sẽ nhảy về polling.
        proxy_read_timeout  3600s;
        proxy_send_timeout  3600s;
        proxy_buffering     off;
    }

    # Không public Swagger/actuator ra Internet.
    location ~ ^/(actuator|v3/api-docs|swagger-ui) {
        return 404;
    }

    location / {
        proxy_pass http://frontend:3000;
        proxy_connect_timeout 10s;
        proxy_read_timeout    60s;
    }
}
