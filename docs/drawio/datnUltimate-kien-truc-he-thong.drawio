FFFF,#333333);fontSize=12;" value="29" vertex="1"><mxGeometry height="20" width="20" x="356" y="1949" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="Sequence - Offline Sync: Đồng bộ hàng đợi SQLite, Idempotency &amp; Batch ACK" id="gqNinq8EkZHYn_efyHHj">
    
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><UserObject label="" mermaidData="{
  &quot;data&quot;: &quot;sequenceDiagram\n    autonumber\n    participant Feature as Mobile Feature\n    participant Queue as SyncQueue\n    participant Local as SQLite offline_queue\n    participant Net as Connectivity\n    participant API as Mobile APIs\n    participant Idem as Idempotency/Command Receipt\n    participant Sync as Sync Batch Handler\n    participant DB as MySQL\n\n    Feature-&gt;&gt;Queue: enqueue(type, payload, clientEventId)\n    Queue-&gt;&gt;Local: INSERT OR IGNORE PENDING\n    Net--&gt;&gt;Queue: Network available\n    Queue-&gt;&gt;Local: SELECT pending ORDER BY priority LIMIT 200\n    Local--&gt;&gt;Queue: Commands + telemetry\n\n    loop Command không phải telemetry\n        Queue-&gt;&gt;API: POST command với clientEventId\n        API-&gt;&gt;Idem: Tìm receipt/idempotency record\n        alt Đã xử lý\n            Idem--&gt;&gt;API: Response cũ\n            API--&gt;&gt;Queue: DUPLICATE/same response\n        else Chưa xử lý\n            API-&gt;&gt;DB: Thực hiện transaction nghiệp vụ\n            API-&gt;&gt;Idem: Lưu receipt/response\n            API--&gt;&gt;Queue: ACCEPTED\n        end\n        Queue-&gt;&gt;Local: Mark SYNCED hoặc FAILED + attempts + last_error\n    end\n\n    opt Có telemetry\n        Queue-&gt;&gt;API: POST /telemetry/batch, batchId + items\n        API-&gt;&gt;Sync: Tạo sync_batches\n        loop Từng item\n            Sync-&gt;&gt;DB: Kiểm tra unique driver/clientEventId\n            Sync-&gt;&gt;DB: Lưu telemetry hoặc xác định duplicate/rejected\n            Sync-&gt;&gt;DB: Lưu sync_batch_items\n        end\n        Sync--&gt;&gt;Queue: ACK từng clientEventId\n        Queue-&gt;&gt;Local: Mark ACCEPTED/DUPLICATE as SYNCED\n    end&quot;,
  &quot;config&quot;: null
}" id="XPFAdUA6UGZr_IwRmhH2-1"><mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1"><mxGeometry as="geometry" /></mxCell></UserObject><UserObject label="Mobile Feature" mermaidId="n:Feature" mermaidBaseStyle="html=1;shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;edgeStyle&quot;:&quot;elbowEdgeStyle&quot;,&quot;elbow&quot;:&quot;vertical&quot;,&quot;curved&quot;:0,&quot;rounded&quot;:0};lifelineDashed=0;strokeWidth=2;rounded=1;absoluteArcSize=1;arcSize=6;lifelineColor=light-dark(#9370DB,#cccccc);size=65;lifelineMirror=1;fillColor=light-dark(#ECECFF,#1f2020);strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="Mobile Feature" id="XPFAdUA6UGZr_IwRmhH2-2"><mxCell parent="XPFAdUA6UGZr_IwRmhH2-1" style="html=1;shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;edgeStyle&quot;:&quot;elbowEdgeStyle&quot;,&quot;elbow&quot;:&quot;vertical&quot;,&quot;curved&quot;:0,&quot;rounded&quot;:0};lifelineDashed=0;strokeWidth=2;rounded=1;absoluteArcSize=1;arcSize=6;lifelineColor=light-dark(#9370DB,#cccccc);size=65;lifelineMirror=1;fillColor=light-dark(#ECECFF,#1f2020);strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" vertex="1"><mxGeometry height="1380" width="150" x="30" y="30" as="geometry" /></mxCell></UserObject><UserObject label="SyncQueue" mermaidId="n:Queue" mermaidBaseStyle="html=1;shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;e