></UserObject><mxCell id="CWoh7cjgZ7t2I6xn3ARD-86" parent="CWoh7cjgZ7t2I6xn3ARD-1" style="ellipse;aspect=fixed;fillColor=light-dark(#333333,#cccccc);align=center;verticalAlign=middle;fontColor=light-dark(#FFFFFF,#333333);fontSize=12;" value="31" vertex="1"><mxGeometry height="20" width="20" x="1765" y="1909" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="Sequence - SOS Emergency: Phát tín hiệu SOS khẩn cấp (Online API &amp; Hàng đợi Offline)" id="AQJjLJThxtjWvazT4XpK">
    
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><UserObject label="" mermaidData="{
  &quot;data&quot;: &quot;sequenceDiagram\n    autonumber\n    actor Driver as Lái xe\n    participant App as Flutter SOS Screen\n    participant GPS as Geolocator\n    participant Queue as SQLite/SyncQueue\n    participant API as MobileController\n    participant Incident as IncidentService\n    participant DB as MySQL\n    participant Notify as NotificationService\n    participant WS as WebSocket/Push\n    participant Web as Incident UI\n    actor Manager as Quản lý\n\n    Driver-&gt;&gt;App: Giữ nút SOS 2 giây\n    App-&gt;&gt;GPS: getCurrentPosition(best)\n    GPS--&gt;&gt;App: lat,lng,accuracy\n    App-&gt;&gt;App: Tạo clientEventId\n\n    alt Online\n        App-&gt;&gt;API: POST /mobile/incidents/sos\n        API-&gt;&gt;Incident: createSos(payload, driver)\n        Incident-&gt;&gt;DB: Kiểm tra clientEventId\n        Incident-&gt;&gt;DB: Lưu Incident OPEN/CRITICAL\n        Incident-&gt;&gt;DB: Lưu IncidentTimeline CREATED\n        Incident-&gt;&gt;Notify: Tạo thông báo ưu tiên\n        Notify-&gt;&gt;WS: Publish incident/notification\n        WS--&gt;&gt;Web: SOS mới\n        API--&gt;&gt;App: incidentCode, OPEN\n        App--&gt;&gt;Driver: Tổng đài đã nhận SOS\n    else Offline/timeout\n        App-&gt;&gt;Queue: enqueueSos(payload)\n        Queue--&gt;&gt;App: QUEUED_OFFLINE\n        App--&gt;&gt;Driver: Đã lưu trên máy, chưa xác nhận tổng đài nhận\n        Queue-&gt;&gt;API: Gửi lại khi có mạng\n        API-&gt;&gt;Incident: createSos idempotent\n    end\n\n    Manager-&gt;&gt;Web: Accept/Assign incident\n    Web-&gt;&gt;API: POST /incidents/{id}/accept hoặc assign\n    API-&gt;&gt;Incident: Cập nhật owner/status\n    Incident-&gt;&gt;DB: Lưu Incident + Timeline\n    Manager-&gt;&gt;Web: Thêm timeline và Close\n    Web-&gt;&gt;API: POST timeline / close\n    API-&gt;&gt;DB: Lưu timeline, resolved_at&quot;,
  &quot;config&quot;: null
}" id="za78IYKDV7NlGrUbiI_p-1"><mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1"><mxGeometry as="geometry" /></mxCell></UserObject><UserObject label="Lái xe" mermaidId="n:Driver" mermaidBaseStyle="html=1;shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;edgeStyle&quot;:&quot;elbowEdgeStyle&quot;,&quot;elbow&quot;:&quot;vertical&quot;,&quot;curved&quot;:0,&quot;rounded&quot;:0};lifelineDashed=0;strokeWidth=2;rounded=1;absoluteArcSize=1;arcSize=6;lifelineColor=light-dark(#9370DB,#cccccc);participant=seqActorStick;verticalAlign=bottom;align=center;spacingBottom=4;size=90;lifelineMirror=1;fillColor=light-dark(#ECECFF,#1f2020);strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="Lái xe" id="za78IYKDV7NlGrUbiI_p-2"><mxCell parent="za78IYKDV7NlGrUbiI_p-1" style="html=1;shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;edgeStyle&quot;:&quot;elbowEdgeStyle&quot;,&quot;elbow&quot;:&quot;vertical&quot;,&quot;curved&quot;:0,&quot;rounded&quot;:0};lifelineDashed=0;strokeWidth=2;rounded=1;absoluteArcSize=1;arcSize=6;lifelineColor=light-dark(#9370DB,#cccccc);participant=seqActorStick;verticalAlign=bottom;align=center;spacingBottom=4;size=90;lifelineMirror=1;fillColor=light-dark(#ECECFF,#1f2020);strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" vertex="1"><mxGeometry height="1606" width="150" x="30" y="30" as="geometry" /></mxCell></UserObject><UserObject label="Flutter SOS Screen" mermaidId="n:App" mermaidBaseStyle="html=1;shape=umlLifeline;perimeter=lifelinePer