    <mxGraphModel grid="1" page="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1654" pageHeight="2336" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><UserObject label="" mermaidData="{
  &quot;data&quot;: &quot;classDiagram\n    class AuthController {\n        &lt;&lt;controller&gt;&gt;\n    }\n    class MobileController {\n        &lt;&lt;controller&gt;&gt;\n    }\n    class TripController {\n        &lt;&lt;controller&gt;&gt;\n    }\n    class TelemetryController {\n        &lt;&lt;controller&gt;&gt;\n    }\n    class SafetyEventController {\n        &lt;&lt;controller&gt;&gt;\n    }\n    class IncidentController {\n        &lt;&lt;controller&gt;&gt;\n    }\n    class FloodReportController {\n        &lt;&lt;controller&gt;&gt;\n    }\n    class WarehouseIssueController {\n        &lt;&lt;controller&gt;&gt;\n    }\n    class ReportController {\n        &lt;&lt;controller&gt;&gt;\n    }\n\n    class AuthService {\n        &lt;&lt;service&gt;&gt;\n        +login()\n        +refresh()\n        +logout()\n    }\n    class MobileAppService {\n        &lt;&lt;facade&gt;&gt;\n        +bootstrap()\n        +workflow()\n        +agentCommand()\n    }\n    class TripService {\n        &lt;&lt;service&gt;&gt;\n        +create()\n        +assign()\n        +start()\n        +pause()\n        +resume()\n        +complete()\n    }\n    class TelemetryService {\n        &lt;&lt;service&gt;&gt;\n        +ingest()\n        +ingestBatch()\n        +currentPositions()\n    }\n    class DrivingTimeService {\n        &lt;&lt;service&gt;&gt;\n        +start()\n        +pause()\n        +resume()\n        +finish()\n    }\n    class SafetyEventService {\n        &lt;&lt;service&gt;&gt;\n        +create()\n        +acknowledge()\n        +resolve()\n        +createIncident()\n    }\n    class IncidentService {\n        &lt;&lt;service&gt;&gt;\n        +createSos()\n        +accept()\n        +assign()\n        +addTimeline()\n        +close()\n    }\n    class FloodReportService {\n        &lt;&lt;service&gt;&gt;\n        +create()\n        +verify()\n        +resolve()\n        +nearby()\n    }\n    class NavigationService {\n        &lt;&lt;service&gt;&gt;\n        +createRoutes()\n        +reroute()\n        +recordEvent()\n    }\n    class WarehouseIssueService {\n        &lt;&lt;service&gt;&gt;\n        +create()\n        +update()\n        +issue()\n        +confirm()\n    }\n    class NotificationService {\n        &lt;&lt;service&gt;&gt;\n        +create()\n        +markRead()\n        +publish()\n    }\n    class ReportService {\n        &lt;&lt;service&gt;&gt;\n        +vehicleStatus()\n        +alertsByType()\n        +tripsByDay()\n    }\n    class SystemSettingService {\n        &lt;&lt;service&gt;&gt;\n        +get()\n        +update()\n    }\n\n    class UserAccount {\n        &lt;&lt;entity&gt;&gt;\n    }\n    class Driver {\n        &lt;&lt;entity&gt;&gt;\n    }\n    class Vehicle {\n        &lt;&lt;entity&gt;&gt;\n    }\n    class Device {\n        &lt;&lt;entity&gt;&gt;\n    }\n    class Trip {\n        &lt;&lt;entity&gt;&gt;\n    }\n    class TripTimeline {\n        &lt;&lt;entity&gt;&gt;\n    }\n    class PreTripChecklist {\n        &lt;&lt;entity&gt;&gt;\n    }\n    class DrivingSession {\n        &lt;&lt;entity&gt;&gt;\n    }\n    class TelemetryLog {\n        &lt;&lt;entity&gt;&gt;\n    }\n    class SafetyEvent {\n        &lt;&lt;entity&gt;&gt;\n    }\n    class Incident {\n        &lt;&lt;entity&gt;&gt;\n    }\n    class IncidentTimeline {\n        &lt;&lt;entity&gt;&gt;\n    }\n    class FloodReport {\n        &lt;&lt;entity&gt;&gt;\n    }\n    class WarehouseIssueDocument {\n        &lt;&lt;entity&gt;&gt;\n    }\n    class WarehouseIssueItem {\n        &lt;&lt;entity&gt;&gt;\n    }\n    class Notification {\n        &lt;&lt;entity&gt;&gt;\n    }\n\n    AuthController --&gt; AuthService\n    MobileController --&gt; MobileAppService\n    TripController --&gt; TripService\n    TelemetryController --&gt; TelemetryService\n    SafetyEventController --&gt; SafetyEventService\n    IncidentController --&gt; IncidentService\n    FloodReportController --&gt; FloodReportService\n    WarehouseIssueController --&gt; WarehouseIssueService\n    ReportController --&gt; ReportService\n\n    MobileAppService --&gt; TripService\n    MobileAppService --&gt; TelemetryService\n    MobileAppService --&gt; SafetyEventService\n    MobileAppService --&gt; DrivingTimeService\n    MobileAppService --&gt; IncidentService\n    MobileAppService --&gt; FloodReportService\n    MobileAppService --&gt; NotificationService\n    TripService --&gt; Trip\n    TripService --&gt; TripTimeline\n    TripService --&gt; Driver\n    TripService --&gt; Vehicle\n    TelemetryService --&gt; TelemetryLog\n    TelemetryService --&gt; Vehicle\n    DrivingTimeService --&gt; DrivingSession\n    SafetyEventService --&gt; SafetyEvent\n    SafetyEventService --&gt; IncidentService\n    SafetyEventService --&gt; NotificationService\n    IncidentService --&gt; Incident\n    IncidentService --&gt; IncidentTimeline\n    IncidentService --&gt; NotificationService\n    FloodReportService --&gt; FloodReport\n    FloodReportService --&gt; NotificationService\n    WarehouseIssueService --&gt; WarehouseIssueDocument\n    WarehouseIssueDocument *-- WarehouseIssueItem\n    NotificationService --&gt; Notification\n\n    UserAccount \&quot;1\&quot; --&gt; \&quot;0..1\&quot; Driver : owns\n    Driver \&quot;0..1\&quot; --&gt; \&quot;0..1\&quot; Vehicle : current\n    Driver \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Trip : drives\n    Vehicle \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Trip : serves\n    Vehicle \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Device : contains\n    Trip \&quot;1\&quot; *-- \&quot;0..*\&quot; TripTimeline\n    Trip \&quot;1\&quot; --&gt; \&quot;0..*\&quot; PreTripChecklist\n    Trip \&quot;1\&quot; --&gt; \&quot;0..*\&quot; DrivingSession\n    Trip \&quot;1\&quot; --&gt; \&quot;0..*\&quot; TelemetryLog\n    Trip \&quot;1\&quot; --&gt; \&quot;0..*\&quot; SafetyEvent\n    Trip \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Incident\n    Incident \&quot;1\&quot; *-- \&quot;0..*\&quot; IncidentTimeline\n    Trip \&quot;0..1\&quot; --&gt; \&quot;0..1\&quot; WarehouseIssueDocument&quot;,
