  &quot;data&quot;: &quot;classDiagram\n    class CameraFrame {\n        +bytes\n        +rotation\n        +timestamp\n    }\n    class CabinObservation {\n        +ear\n        +mar\n        +iris\n        +pitch\n        +yaw\n        +phoneConfidence\n        +speedKph\n    }\n    class CabinMetrics {\n        +score\n        +predictedScore\n        +trend\n        +fps\n        +severity\n    }\n    class SafetyDetection {\n        +type\n        +confidence\n        +severity\n        +reason\n        +source\n    }\n    class CabinAiController\n    class StgtDrowsinessEngine\n    class TemporalSafetyEngine\n    class DocumentScanService\n    class PreprocessedDocument {\n        +originalBytes\n        +scanBytes\n        +score\n        +issues\n        +hardFailure\n    }\n    class DocumentOcrSnapshot {\n        +text\n        +lines\n        +width\n        +height\n        +kind\n    }\n    class DocumentOcrLine {\n        +text\n        +boundingBox\n        +angle\n        +confidence\n        +elements\n    }\n    class DocumentFieldExtraction {\n        +voucherDate\n        +voucherNumber\n        +vehiclePlate\n        +projectAddress\n        +confidences\n    }\n    class DrivingLogEntry\n\n    CameraFrame --&gt; CabinAiController : input\n    CabinAiController --&gt; CabinObservation : extracts\n    CabinAiController --&gt; StgtDrowsinessEngine : primary\n    CabinAiController --&gt; TemporalSafetyEngine : fallback\n    StgtDrowsinessEngine --&gt; CabinMetrics : produces\n    TemporalSafetyEngine --&gt; SafetyDetection : produces\n    CabinMetrics --&gt; SafetyDetection : triggers\n\n    DocumentScanService --&gt; PreprocessedDocument : preprocesses\n    DocumentScanService --&gt; DocumentOcrSnapshot : recognizes\n    DocumentOcrSnapshot *-- DocumentOcrLine\n    DocumentOcrSnapshot --&gt; DocumentFieldExtraction : extracted_by\n    DocumentFieldExtraction --&gt; DrivingLogEntry : populates\n    PreprocessedDocument --&gt; DrivingLogEntry : supplies_images_quality&quot;,
  &quot;config&quot;: null
