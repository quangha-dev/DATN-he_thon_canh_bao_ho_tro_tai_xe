"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1090" y="1718.05" /></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram name="Sequence - Auth &amp; Session: Đăng nhập JWT, Làm mới Refresh Token &amp; Đăng xuất" id="CVM2Jh43mP1OIQXZGNlu">
    
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><UserObject label="" mermaidData="{
  &quot;data&quot;: &quot;sequenceDiagram\n    autonumber\n    actor User as Lái xe / Quản lý\n    participant FE as Flutter App / Next.js Web\n    participant API as AuthController\n    participant Auth as AuthService\n    participant DB as MySQL\n    participant JWT as JwtService\n    participant Store as SecureStorage / localStorage\n\n    User-&gt;&gt;FE: Nhập username/email và password\n    FE-&gt;&gt;API: POST /api/v1/auth/login\n    API-&gt;&gt;Auth: login(request)\n    Auth-&gt;&gt;DB: Tìm UserAccount, role, driver\n    DB--&gt;&gt;Auth: User + password_hash + status + role\n    Auth-&gt;&gt;Auth: BCrypt verify và kiểm tra trạng thái\n    Auth-&gt;&gt;JWT: Tạo access token\n    JWT--&gt;&gt;Auth: accessToken\n    Auth-&gt;&gt;DB: Lưu refresh_token dạng hash\n    DB--&gt;&gt;Auth: refresh token record\n    Auth--&gt;&gt;API: AuthResponse\n    API--&gt;&gt;FE: accessToken, refreshToken, user\n    FE-&gt;&gt;Store: Lưu token\n    FE--&gt;&gt;User: Mở màn hình theo actor/role\n\n    alt Access token hết hạn\n        FE-&gt;&gt;API: POST /auth/refresh\n        API-&gt;&gt;Auth: refresh(refreshToken)\n        Auth-&gt;&gt;DB: Kiểm tra token hash, expires_at, revoked_at\n        DB--&gt;&gt;Auth: Token hợp lệ/không hợp lệ\n        Auth-&gt;&gt;JWT: Tạo access token mới\n        JWT--&gt;&gt;FE: Phiên mới\n    end\n\n    User-&gt;&gt;FE: Đăng xuất\n    FE-&gt;&gt;API: POST /auth/logout\n    API-&gt;&gt;DB: Đánh dấu refresh token revoked_at\n    API--&gt;&gt;FE: Thành công\n    FE-&gt;&gt;Store: Xóa token&quot;,
  &quot;config&quot;: null
}" id="pYKDqCXGYWxQJjVuL03U-1"><mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1"><mxGeometry as="geometry" /></mxCell></UserObject><UserObject label="Lái xe / Quản lý" mermaidId="n:User" mermaidBaseStyle="html=1;shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;edgeStyle&quot;:&quot;elbowEdgeStyle&quot;,&quot;elbow&quot;:&quot;vertical&quot;,&quot;curved&quot;:0,&quot;rounded&quot;:0};lifelineDashed=0;strokeWidth=2;rounded=1;absoluteArcSize=1;arcSize=6;lifelineColor=light-dark(#9370DB,#cccccc);participant=seqActorStick;verticalAlign=bottom;align=center;spacingBottom=4;size=90;lifelineMirror=1;fillColor=light-dark(#ECECFF,#1f2020);strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="Lái xe / Quản lý" id="pYKDqCXGYWxQJjVuL03U-2"><mxCell parent="pYKDqCXGYWxQJjVuL03U-1" style="html=1;shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;edgeStyle&quot;:&quot;elbowEdgeStyle&quot;,&quot;elbow&quot;:&quot;vertical&quot;,&quot;curved&quot;:0,&quot;rounded&quot;:0};lifelineDashed=0;strokeWidth=2;rounded=1;absoluteArcSize=1;arcSize=6;lifelineColor=light-dark(#9370DB,#cccccc);participant=seqActorStick;verticalAlign=bottom;align=center;spacingBottom=4;size=90;lifelineMirror=1;fillColor=light-dark(#ECECFF,#1f2020);strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" vertex="1"><mxGeometry height="1453" width="150" x="30" y="70" as="geometry" /></mxCell></UserObject><UserObject label="Flutter App / Next.js Web" mermaidId="n:FE" mermaidBaseStyle="html=1;shape=umlLifeli