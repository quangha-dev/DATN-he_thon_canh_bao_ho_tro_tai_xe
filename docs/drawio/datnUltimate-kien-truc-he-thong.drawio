&lt;/font&gt;" vertex="1"><mxGeometry relative="1" x="0.0881" y="1" as="geometry"><mxPoint as="offset" /></mxGeometry></mxCell><mxCell id="rhdTdXk6J7boGRhr2Eqd-29" edge="1" parent="az3VQochRnjHFLrISrvy-1" source="az3VQochRnjHFLrISrvy-189" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endSize=7;strokeColor=#000000;strokeWidth=1.5;fontSize=12;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontColor=#000000;jumpStyle=arc;jumpSize=6;entryX=1;fontStyle=1;" target="az3VQochRnjHFLrISrvy-190"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ceDRQjDRRiL88-9nVCHQ-7" edge="1" parent="az3VQochRnjHFLrISrvy-1" source="az3VQochRnjHFLrISrvy-135" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endSize=7;strokeColor=#000000;strokeWidth=1.5;fontSize=12;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontColor=#000000;jumpStyle=arc;jumpSize=6;entryX=0.5;fontStyle=1;" target="az3VQochRnjHFLrISrvy-137"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ceDRQjDRRiL88-9nVCHQ-8" edge="1" parent="az3VQochRnjHFLrISrvy-1" source="az3VQochRnjHFLrISrvy-141" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endSize=7;strokeColor=#000000;strokeWidth=1.5;fontSize=12;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontColor=#000000;jumpStyle=arc;jumpSize=6;fontStyle=1;" target="az3VQochRnjHFLrISrvy-135"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="ceDRQjDRRiL88-9nVCHQ-22" edge="1" parent="az3VQochRnjHFLrISrvy-1" source="az3VQochRnjHFLrISrvy-153" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endSize=7;strokeColor=#000000;strokeWidth=1.5;fontSize=12;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontColor=#000000;jumpStyle=arc;jumpSize=6;fontStyle=1;" target="az3VQochRnjHFLrISrvy-135"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="Activity - Dispatch: Lập kế hoạch điều phối chuyến &amp; Cấp phát phiếu xuất kho" id="LK3IREuOkm_n_79rl0Bm"><mxGraphModel grid="1" page="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1654" pageHeight="2336" math="0" shadow="0"><root><mxCell id="0" style="fontStyle=1;" /><mxCell id="1" parent="0" style="fontStyle=1;" /><UserObject label="" plantUmlData="{
  &quot;data&quot;: &quot;@startuml\ntitle Biểu đồ hoạt động: A2 - Quản lý điều phối chuyến và phiếu xuất kho\n\n|#E8F5E9| Quản lý (User) |\n|#E3F2FD| Frontend Web (Admin Console) |\n|#FFF3E0| Backend Server &amp; DB |\n\n|Quản lý (User)|\nstart\n:Mở màn hình Điều phối;\n\nrepeat\n  :Nhập loại chuyến, điểm đi và điểm đến;\n  \n  |Frontend Web (Admin Console)|\n  :Hiển thị gợi ý Autocomplete (có tọa độ);\n  \n  |Quản lý (User)|\n  :Chọn địa điểm từ Autocomplete;\n  :Nhập thời gian bắt đầu và kết thúc;\n  \n  |Frontend Web (Admin Console)|\n  :Kiểm tra tính hợp lệ của địa điểm và lịch;\nbackward :Đánh dấu trường lỗi và giữ dữ liệu;\nrepeat while (Địa điểm và lịch hợp lệ?) is (Không)\n-&gt;Có;\n\n|Backend Server &amp; DB|\n:Tính toán Route, ETA và rủi ro ngập lụt;\n\n|Frontend Web (Admin Console)|\n:Hiển thị bản đồ và Route Summary;\n\n|Backend Server &amp; DB|\n:Tải danh sách tài xế - xe khả dụng;\n:Xử lý gợi ý điều phối (AI/Algorithm);\n\n|Frontend Web (Admin Console)|\nif (Có gợi ý từ Backend?) then (Có)\n  :Hiển thị cặp đề xuất và lý do gợi ý;\nelse (Không)\n  :Dùng Heuristic Client và ghi rõ fallback;\nendif\n\n|Quản lý (User)|\n:Chọn / Xác nhận cặp tài xế - xe;\n\nrepeat\n  :Nhập phiếu xuất kho và các dòng hàng hóa;\n  \n  |Frontend Web (Admin Console)|\n  :Kiểm tra dữ liệu phiếu và số lượng;\nbackward :Hiển thị lỗi đúng dòng hàng hóa;\nrepeat while (Phiếu và số lượng hợp lệ?) is (Không)\n-&gt;Có;\n\n|Quản lý (User)|\nif (Chọn hành động) then (Lưu nháp)\n  |Backend Server &amp; DB|\n  :Lưu / Cập nhật Trip (DRAFT)\\nvà WarehouseIssue (DRAFT);\n  \n  |Frontend Web (Admin Console)|\n  :Hiển thị mã bản nháp;\n  \n  |Quản lý (User)|\n  stop\n\nelse (Phát hành)\n  |Backend Server &amp; DB|\n  :Lưu Trip chính thức và gán tài xế - xe;\n  :Phát hành WarehouseIssue;\n  :Ghi Trip Timeline và Warehouse Audit Log;\n  :Gửi thông báo Push Notification tới tài xế;\n  \n  |Frontend Web (Admin Console)|\n  :Cập nhật trạng thái chuyến lên App tài xế;\n  \n  |Quản lý (User)|\n  :Chuyến xuất hiện trên App tài xế;\n  stop\nendif\n@enduml&quot;,
  &quot;config&quot;: null
}" id="r9J204xnlrVUk79E8yun-1"><mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;fontStyle=1;" vertex="1"><mxGeometry height="1880" width="1408" as="geometry" /></mxCell></UserObject><UserObject label="Quản lý (User)" plantUmlId="lane_107" plantUmlBaseStyle="swimlane;collapsible=0;startSize=30;fillColor=#E8F5E9;swimlaneFillColor=#E8F5E9;strokeColor=#181818;strokeWidth=1.5;fontColor=#000000;fontSize=18;fontStyle=0;html=1;" plantUmlBaseValue="Quản lý (User)" id="r9J204xnlrVUk79E8yun-2"><mxCell parent="r9J204xnlrVUk79E8yun-1" style="swimlane;collapsible=0;startSize=30;fillColor=none;swimlaneFillColor=none;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=18;fontStyle=1;html=1;" vertex="1"><mxGeometry height="1850" width="454.5" x="1" y="20" as="geometry" /></mxCell></UserObject><UserObject label="Nhập loại chuyến, điểm đi và điểm đến" plantUmlId="action_7" plantUmlBaseStyle="rounded=1;absoluteArcSize=1;arcSize=25;fillColor=#F1F1F1;strokeColor=#181818;strokeWidth=0.5;whiteSpace=wrap;fontSize=12;align=left;spacingLeft=6;" plantUmlBaseValue="Nhập loại chuyến, điểm đi và điểm đến" id="r9J204xnlrVUk79E8yun-11"><mxCell parent="r9J204xnlrVUk79E8yun-2" style="rounded=1;absoluteArcSize=1;arcSize=25;fillColor=#ffffff;strokeColor=#000000;strokeWidth=0.5;whiteSpace=wrap;fontSize=12;align=left;spacingLeft=6;fontStyle=1;fontColor=#000000;" vertex="1"><mxGeometry height="36" width="234" x="110.25" y="170" as="geometry" /></mxCell></UserObject><UserObject label="Mở màn hình Điều phối" plantUmlId="action_2" plantUmlBaseStyle="rounded=1;absoluteArcSize=1;arcSize=25;fillColor=#F1F1F1;strokeColor=#181818;strokeWidth=0.5;whiteSpace=wrap;fontSize=12;align=left;spacingLeft=6;" plantUmlBaseValue="Mở màn hình Điều phối" id="r9J204xnlrVUk79E8yun-7"><mxCell parent="r9J204xnlrVUk79E8yun-2" style="rounded=1;absoluteArcSize=1;arcSize=25;fillColor=#ffffff;strokeColor=#000000;strokeWidth=0.5;whiteSpace=wrap;fontSize=12;align=left