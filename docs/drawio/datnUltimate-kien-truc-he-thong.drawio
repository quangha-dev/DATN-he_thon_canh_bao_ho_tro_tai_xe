09" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endSize=7;strokeColor=#000000;strokeWidth=1.5;fontSize=12;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontColor=#000000;jumpStyle=arc;jumpSize=6;entryX=0.5;fontStyle=1;" target="0hwkKZOwayztivsvXmVL-111"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="Activity - Telemetry: Thu thập tọa độ GPS, Gửi vị trí ngầm &amp; Giám sát realtime" id="2xIPbTYqOGKfmNgfc30U"><mxGraphModel grid="1" page="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1654" pageHeight="2336" math="0" shadow="0"><root><mxCell id="0" style="fontStyle=1;" /><mxCell id="1" parent="0" style="fontStyle=1;" /><UserObject label="" plantUmlData="{
  &quot;data&quot;: &quot;@startuml\ntitle Biểu đồ hoạt động: A4 - GPS, telemetry và giám sát realtime\n\n|#E3F2FD| Lái xe / Điện thoại App |\n|#FFF3E0| Backend Server |\n|#E8F5E9| Quản lý (Web Dashboard) |\n\n|Lái xe / Điện thoại App|\nstart\n:Đăng nhập hệ thống;\n:Lấy Driver, Vehicle và Trip hiện tại;\n\nif (Có quyền và dịch vụ GPS?) then (Có)\n  :Khởi động Position Stream / Foreground Service;\n  \n  repeat\n    :Tạo bản ghi Telemetry kèm clientEventId;\n    :Lưu bản ghi vào offline_queue (SQLite);\n    \n    if (Có kết nối mạng?) then (Không)\n      :Giữ trạng thái PENDING trong offline_queue;\n    else (Có)\n      :Gửi Telemetry Batch lên Server;\n      \n      |Backend Server|\n      :Kiểm tra JWT, quyền, dữ liệu và Idempotency;\n      :Lưu telemetry_logs và cập nhật vị trí cuối của Vehicle;\n      :Publish thông điệp WebSocket (vehicle-position);\n      \n      |Quản lý (Web Dashboard)|\n      :Nhận WebSocket &amp; Cập nhật Marker, tốc độ và thời gian cuối trên bản đồ;\n      \n      if (WebSocket bị gián đoạn?) then (Có)\n        :Hiển thị \&quot;Reconnecting\&quot; và bật Polling REST làm fallback;\n      else (Không)\n        :Tiếp tục hiển thị Realtime;\n      endif\n    endif\n  repeat while (Ứng dụng tiếp tục phát GPS)\n\nelse (Không)\n  |Lái xe / Điện thoại App|\n  :Thông báo chức năng bị giới hạn (Mất GPS);\n  stop\nendif\n@enduml&quot;,
  &quot;config&quot;: null
}" id="pSecwZYwha8hvHkZI4A7-1"><mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;fontStyle=1;" vertex="1"><mxGeometry height="1370" width="1880" as="geometry" /></mxCell></UserObject><UserObject label="Lái xe / Điện thoại App" plantUmlId="lane_67" plantUmlBaseStyle="swimlane;collapsible=0;startSize=30;fillColor=#E3F2FD;swimlaneFillColor=#E3F2FD;strokeColor=#181818;strokeWidth=1.5;fontColor=#000000;fontSize=18;fontStyle=0;html=1;" plantUmlBaseValue="Lái xe / Điện thoại App" id="pSecwZYwha8hvHkZI4A7-2"><mxCell parent="pSecwZYwha8hvHkZI4A7-1" style="swimlane;collapsible=0;startSize=30;fillColor=none;swimlaneFillColor=none;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=18;fontStyle=1;html=1;" vertex="1"><mxGeometry height="1260" width="657" x="80" y="30" as="geometry" /></mxCell></UserObject><UserObject label="" plantUmlId="start_0" plantUmlBaseStyle="ellipse;fillColor=#222222;strokeColor=#222222;" plantUmlBaseValue="" id="pSecwZYwha8hvHkZI4A7-5"><mxCell parent="pSecwZYwha8hvHkZI4A7-2" style="ellipse;fillColor=#000000;strokeColor=#000000;fontStyle=1;" vertex="1"><mxGeometry height="20" width="20" x="307" y="60" as="geometry" /></mxCell></UserObject><mxCell id="0Zsuu04NUX4ABE50tfsQ-1" edge="1" parent="pSecwZYwha8hvHkZI4A7-2" source="pSecwZYwha8hvHkZI4A7-7" style="edgeStyle=orthogonalEdgeStyle;rounded=1;arcSize=8;orthogonalLoop=1;jettySize=auto;html=1;endArrow=classic;endSize=7;strokeColor=#000000;strokeWidth=1.5;fontSize=12;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontColor=#000000;jumpStyle=arc;jumpSize=6;entryX=0.5;fontStyle=1;" target="pSecwZYwha8hvHkZI4A7-9"><mxGeometry relative="1" as="geometry" /></mxCell><UserObject label="Đăng nhập hệ thống" plantUmlId="action_2" plantUmlBaseStyle="rounded=1;absoluteArcSize=1;arcSize=25;fillColor=#F1F1F1;strokeColor=#181818;strokeWidth=0.5;whiteSpace=wrap;fontSize=12;align=left;spacingLeft=6;" plantUmlBaseValue="Đăng nhập hệ thống" id="pSecwZYwha8h