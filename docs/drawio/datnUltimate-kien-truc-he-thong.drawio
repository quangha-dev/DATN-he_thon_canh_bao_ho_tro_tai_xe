    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><UserObject label="" mermaidData="{
  &quot;data&quot;: &quot;erDiagram\n    USERS {\n        bigint id PK\n        bigint role_id FK\n        varchar username\n    }\n    DRIVERS {\n        bigint id PK\n        bigint user_id FK\n    }\n    VEHICLES {\n        bigint id PK\n        varchar plate_number\n    }\n    TRIPS {\n        bigint id PK\n        varchar trip_code\n    }\n    MOBILE_DEVICES {\n        bigint id PK\n        bigint user_id FK\n        varchar device_uuid UK\n        varchar platform\n        datetime last_seen_at\n    }\n    REFRESH_TOKENS {\n        bigint id PK\n        bigint user_id FK\n        char token_hash UK\n        datetime expires_at\n        datetime revoked_at\n    }\n    IDEMPOTENCY_RECORDS {\n        bigint id PK\n        bigint user_id FK\n        varchar idempotency_key UK\n        varchar request_path\n        int response_status\n        datetime expires_at\n    }\n    SYNC_BATCHES {\n        bigint id PK\n        bigint user_id FK\n        bigint device_id FK\n        varchar batch_uuid UK\n        varchar status\n        int accepted_count\n        int duplicate_count\n        int rejected_count\n    }\n    SYNC_BATCH_ITEMS {\n        bigint id PK\n        bigint sync_batch_id FK\n        varchar client_event_id\n        varchar item_type\n        varchar item_status\n        bigint entity_id\n    }\n    MOBILE_COMMAND_RECEIPTS {\n        bigint id PK\n        bigint user_id FK\n        bigint trip_id FK\n        varchar client_event_id UK\n        varchar operation\n        longtext response_json\n    }\n    AGENT_COMMANDS {\n        bigint id PK\n        bigint user_id FK\n        bigint driver_id FK\n        bigint trip_id FK\n        varchar command_type\n        varchar interpreted_intent\n        varchar status\n        double confidence\n    }\n    NAVIGATION_SESSIONS {\n        bigint id PK\n        bigint driver_id FK\n        bigint vehicle_id FK\n        bigint trip_id FK\n        bigint selected_candidate_id FK\n        varchar session_uuid UK\n        varchar status\n    }\n    NAVIGATION_ROUTE_CANDIDATES {\n        bigint id PK\n        bigint navigation_session_id FK\n        int route_index\n        int distance_meters\n        int duration_seconds\n        decimal total_score\n        boolean safe\n        boolean blocked\n    }\n    NAVIGATION_EVENTS {\n        bigint id PK\n        bigint navigation_session_id FK\n        varchar event_type\n        int distance_to_route_meters\n        decimal gps_accuracy_meters\n        datetime occurred_at\n    }\n    NOTIFICATIONS {\n        bigint id PK\n        bigint recipient_id FK\n        varchar type\n        varchar reference_type\n        bigint reference_id\n        datetime read_at\n    }\n    NOTIFICATION_READS {\n        bigint notification_id PK, FK\n        bigint user_id PK, FK\n        datetime read_at\n    }\n    PUSH_TOKENS {\n        bigint id PK\n        bigint user_id FK\n        bigint device_id FK\n        varchar provider\n        varchar token UK\n        boolean enabled\n    }\n    PENDING_PUSH_NOTIFICATIONS {\n        bigint id PK\n        bigint notification_id FK\n        bigint user_id FK\n        bigint push_token_id FK\n        varchar status\n        int attempt_count\n        datetime next_attempt_at\n    }\n    SAFETY_EVENT_EVIDENCE {\n        bigint id PK\n        bigint safety_event_id FK\n        bigint incident_id FK\n        bigint uploaded_by FK\n        varchar object_key UK\n        char sha256\n    }\n    SAFETY_EVENTS {\n        bigint id PK\n    }\n    INCIDENTS {\n        bigint id PK\n    }\n    SYSTEM_SETTINGS {\n        bigint id PK\n        bigint updated_by FK\n        varchar setting_key UK\n        varchar setting_group\n        text setting_value\n        varchar value_type\n    }\n    AUDIT_LOGS {\n        bigint id PK\n        bigint actor_id FK\n        varchar action\n        varchar target_type\n        bigint target_id\n        datetime created_at\n    }\n\n    USERS ||--o{ MOBILE_DEVICES : registers\n    USERS ||--o{ REFRESH_TOKENS : owns\n    USERS ||--o{ IDEMPOTENCY_RECORDS : creates\n    USERS ||--o{ SYNC_BATCHES : uploads\n    MOBILE_DEVICES o|--o{ SYNC_BATCHES : source\n    SYNC_BATCHES ||--o{ SYNC_BATCH_ITEMS : contains\n    USERS ||--o{ MOBILE_COMMAND_RECEIPTS : owns\n    TRIPS o|--o{ MOBILE_COMMAND_RECEIPTS : concerns\n    USERS ||--o{ AGENT_COMMANDS : issues\n    DRIVERS o|--o{ AGENT_COMMANDS : speaks\n    TRIPS o|--o{ AGENT_COMMANDS : context\n    DRIVERS ||--o{ NAVIGATION_SESSIONS : starts\n    VEHICLES o|--o{ NAVIGATION_SESSIONS : uses\n    TRIPS o|--o{ NAVIGATION_SESSIONS : guides\n    NAVIGATION_SESSIONS ||--o{ NAVIGATION_ROUTE_CANDIDATES : has\n    NAVIGATION_ROUTE_CANDIDATES o|--o{ NAVIGATION_SESSIONS : selected_by\n    NAVIGATION_SESSIONS ||--o{ NAVIGATION_EVENTS : records\n    USERS o|--o{ NOTIFICATIONS : receives\n    NOTIFICATIONS ||--o{ NOTIFICATION_READS : read_state\n    USERS ||--o{ NOTIFICATION_READS : reads\n    USERS ||--o{ PUSH_TOKENS : owns\n    MOBILE_DEVICES o|--o{ PUSH_TOKENS : hosts\n    NOTIFICATIONS o|--o{ PENDING_PUSH_NOTIFICATIONS : queues\n    USERS ||--o{ PENDING_PUSH_NOTIFICATIONS : receives\n    PUSH_TOKENS o|--o{ PENDING_PUSH_NOTIFICATIONS : targets\n    SAFETY_EVENTS o|--o{ SAFETY_EVENT_EVIDENCE : evidences\n    INCIDENTS o|--o{ SAFETY_EVENT_EVIDENCE : evidences\n    USERS ||--o{ SAFETY_EVENT_EVIDENCE : uploads\n    USERS o|--o{ SYSTEM_SETTINGS : updates\n    USERS o|--o{ AUDIT_LOGS : acts&quot;,
  &quot;config&quot;: null
