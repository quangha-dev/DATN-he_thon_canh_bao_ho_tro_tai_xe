block;endSize=9;verticalAlign=bottom;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=16;labelBackgroundColor=none;strokeWidth=1.5;strokeColor=light-dark(#333333,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;" target="pYKDqCXGYWxQJjVuL03U-3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="547" y="1369" /></Array><mxPoint x="687" y="1369" as="sourcePoint" /><mxPoint x="406" y="1369" as="targetPoint" /></mxGeometry></mxCell></UserObject><mxCell id="pYKDqCXGYWxQJjVuL03U-59" parent="pYKDqCXGYWxQJjVuL03U-1" style="ellipse;aspect=fixed;fillColor=light-dark(#333333,#cccccc);align=center;verticalAlign=middle;fontColor=light-dark(#FFFFFF,#333333);fontSize=12;" value="24" vertex="1"><mxGeometry height="20" width="20" x="677" y="1359" as="geometry" /></mxCell><UserObject label="Xóa token" mermaidId="e:FE-&gt;Store#1" mermaidBaseStyle="endArrow=block;endSize=9;verticalAlign=bottom;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=16;labelBackgroundColor=none;strokeWidth=1.5;strokeColor=light-dark(#333333,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;" mermaidBaseValue="Xóa token" id="pYKDqCXGYWxQJjVuL03U-60"><mxCell edge="1" parent="pYKDqCXGYWxQJjVuL03U-1" source="pYKDqCXGYWxQJjVuL03U-3" style="endArrow=block;endSize=9;verticalAlign=bottom;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=16;labelBackgroundColor=none;strokeWidth=1.5;strokeColor=light-dark(#333333,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;" target="pYKDqCXGYWxQJjVuL03U-8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1035" y="1413" /></Array><mxPoint x="406" y="1413" as="sourcePoint" /><mxPoint x="1663" y="1413" as="targetPoint" /></mxGeometry></mxCell></UserObject><mxCell id="pYKDqCXGYWxQJjVuL03U-61" parent="pYKDqCXGYWxQJjVuL03U-1" style="ellipse;aspect=fixed;fillColor=light-dark(#333333,#cccccc);align=center;verticalAlign=middle;fontColor=light-dark(#FFFFFF,#333333);fontSize=12;" value="25" vertex="1"><mxGeometry height="20" width="20" x="396" y="1403" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="Sequence - Dispatch: Điều phối chuyến, Ghép cặp xe-tài xế &amp; Đẩy phiếu xuất kho" id="0aMvnCTL2FMIwtkg3xdn">
    
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><UserObject label="" mermaidData="{
  &quot;data&quot;: &quot;sequenceDiagram\n    autonumber\n    actor Manager as Quản lý\n    participant Web as Next.js Dispatch UI\n    participant Loc as LocationController\n    participant Route as Location/Routing Provider\n    participant Dispatch as DispatchController\n    participant Trip as TripController/TripService\n    participant WH as WarehouseIssueController/Service\n    participant Notify as NotificationService\n    participant WS as WebSocket/Push\n    participant DB as MySQL\n    participant App as Flutter Driver App\n\n    Manager-&gt;&gt;Web: Nhập điểm đi/đến\n    Web-&gt;&gt;Loc: GET /locations/autocomplete\n    Loc-&gt;&gt;Route: Geocode/autocomplete\n    Route--&gt;&gt;Web: Danh sách địa điểm có tọa độ\n    Manager-&gt;&gt;Web: Chọn địa điểm và lịch\n    Web-&gt;&gt;Loc: POST /locations/route\n    Loc-&gt;&gt;Route: Tính geometry, distance, ETA\n    Route--&gt;&gt;Web: Route summary\n\n    Web-&gt;&gt;Dispatch: GET /dispatch/suggestions\n    Dispatch-&gt;&gt;DB: Đọc xe và tài xế khả dụng\n    DB--&gt;&gt;Dispatch: Candidates\n    Dispatch--&gt;&gt;Web: Gợi ý và lý do\n    Manager-&gt;&gt;Web: Chọn tài xế–xe, nhập phiếu và hàng hóa\n\n    alt Lưu nháp\n        Web-&gt;&gt;Trip: POST/PUT /trips\n        Trip-&gt;&gt;DB: Lưu Trip DRAFT + TripTimeline\n        Web-&gt;&gt;WH: POST/PUT /warehouse-issues\n        WH-&gt;&gt;DB: Lưu document DRAFT + items + audit\n        DB--&gt;&gt;Web: tripId, tripCode, documentId\n    else Phát hành và điều phối\n        Web-&gt;&gt;Trip: POST/PUT /trips\n        Trip-&gt;&gt;DB: Lưu Trip\n        Web-&gt;&gt;Trip: POST /trips/{id}/assign\n        Trip-&gt;&gt;DB: Gán Driver/Vehicle, cập nhật ASSIGNED và timeline\n        Web-&gt;&gt;WH: POST/PUT /warehouse-issues\n        WH-&gt;&gt;DB: Lưu document và items\n        Web-&gt;&gt;WH: POST /warehouse-issues/{id}/issue\n        WH-&gt;&gt;DB: Cập nhật ISSUED + issued_at + audit log\n        Trip-&gt;&gt;Notify: Thông báo chuyến mới\n        Notify-&gt;&gt;DB: Lưu notifications/pending push\n        Notify-&gt;&gt;WS: Publish notification\n        WS--&gt;&gt;App: Chuyến mới\n    end&quot;,
  &quot;config&quot;: null
}" id="Lo49zpAiYK4JiOV5r5BV-8"><mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1"><mxGeometry as="geometry" /></mxCell></UserObject><UserObject label="Quản lý" mermaidId="n:Manager" mermaidBaseStyle="html=1;shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;edgeStyle&quot;:&quot;elbowEdgeStyle&quot;,&quot;elbow&quot;:&quot;vertical&quot;,&quot;curved&quot;:0,&quot;rounded&quot;:0};lifelineDashed=0;strokeWidth=2;rounded=1;absoluteArcSize=1;arcSize=6;lifelineColor=light-dark(#9370DB,#cccccc);participant=seqActorStick;verticalAlign=bottom;align=center;spacingBottom=4;size=90;lifelineMirror=1;fillColor=light-dark(#ECECFF,#1f2020);strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="Quản lý" id="Lo49zpAiYK4JiOV5r5BV-9"><mxCell parent="Lo49zpAiYK4JiOV5r5BV-8" style="html=1;shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;edgeStyle&quot;:&quot;elbowEdgeStyle&quot;,&quot;elbow&quot;:&quot;vertical&quot;,&quot;curved&quot;:0,&quot;rounded&quot;:0};lifelineDashed=0;strokeWidth=2;rounded=1;absoluteArcSize=1;arcSize=6;lifelineColor=light-dark(#9370DB,#cccccc);participant=seqActorStick;verticalAlign=bottom;align=center;spacingBottom=4;size=90;lifelineMirror=1;fillColor=light-dark(#ECECFF,#1f2020);strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" vertex="1"><mxGeometry height="1742" width="150" x="230" y="1230" as="geometry" /></mxCell></UserObject><UserObject label="Next.js Dispatch UI" mermaidId="n:Web" mermaidBaseStyle="html=1;shape=umlLifeline;perimeter=life