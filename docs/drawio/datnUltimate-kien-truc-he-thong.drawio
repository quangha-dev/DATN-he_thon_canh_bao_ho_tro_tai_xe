  &quot;data&quot;: &quot;@startuml\ntitle Biểu đồ hoạt động: A3 - Lái xe thực hiện chuyến\n\n|#E8F5E9| Lái xe (User) |\n|#E3F2FD| App Lái xe (Flutter / SQLite) |\n|#FFF3E0| Backend Server &amp; DB |\n\n|Lái xe (User)|\nstart\n:Mở chi tiết chuyến;\n\n|App Lái xe (Flutter / SQLite)|\n:Xem tuyến, lịch, rủi ro và phiếu xuất kho;\nif (Trạng thái chuyến?) then (COMPLETED / CANCELLED)\n  |Lái xe (User)|\n  :Chỉ xem lịch sử chuyến;\n  stop\n\nelse (IN_PROGRESS / RESTING)\n  |App Lái xe (Flutter / SQLite)|\n  :Mở lại chế độ lái (Driving Mode);\n\nelse (ASSIGNED / ACCEPTED)\n  |App Lái xe (Flutter / SQLite)|\n  :Mở checklist trước chuyến;\n  \n  |Lái xe (User)|\n  repeat\n    :Kiểm tra 7 mục: ngoại thất, lốp, phanh,\\nđèn, camera, GPS, giấy tờ;\n    \n    |App Lái xe (Flutter / SQLite)|\n    if (Đủ 7 mục?) then (Có)\n      break\n    else (Không)\n      :Chặn nút bắt đầu và chỉ rõ mục thiếu;\n      |Lái xe (User)|\n    endif\n  repeat while (Chưa đủ checklist)\n\n  |App Lái xe (Flutter / SQLite)|\n  :Gửi checklist lên hệ thống;\n  :Gửi start-workflow với clientEventId;\n  \n  if (Có mạng?) then (Không)\n    :Lưu TRIP_WORKFLOW vào SQLite;\n  else (Có)\n    |Backend Server &amp; DB|\n    :Khởi tạo DrivingSession\\nvà cập nhật trạng thái chuyến;\n  endif\n  \n  |App Lái xe (Flutter / SQLite)|\n  :Mở chế độ lái (Driving Mode);\nendif\n\n|App Lái xe (Flutter / SQLite)|\nrepeat\n  :Gửi GPS và navigation event định kỳ;\n  \n  |Lái xe (User)|\n  if (Chọn hành động) then (Tạm nghỉ)\n    |App Lái xe (Flutter / SQLite)|\n    :Gửi pause-workflow;\n    \n    |Backend Server &amp; DB|\n    :Cập nhật trạng thái RESTING;\n    \n    |Lái xe (User)|\n    repeat\n      :Tạm nghỉ tại điểm dừng;\n    repeat while (Tiếp tục?) is (Chưa)\n    -&gt;Có;\n    \n    |App Lái xe (Flutter / SQLite)|\n    :Gửi resume-workflow;\n    \n    |Backend Server &amp; DB|\n    :Khôi phục trạng thái IN_PROGRESS;\n\n  else (Hoàn thành)\n    |App Lái xe (Flutter / SQLite)|\n    :Hiển thị hộp thoại xác nhận hoàn thành;\n    \n    |Lái xe (User)|\n    if (Xác nhận?) then (Có)\n      |App Lái xe (Flutter / SQLite)|\n      :Gửi complete-workflow;\n      \n      if (Có mạng?) then (Không)\n        :Lưu command chờ đồng bộ vào SQLite;\n        |Lái xe (User)|\n        :Hiển thị \&quot;Đang chờ đồng bộ\&quot;;\n        stop\n      else (Có)\n        |Backend Server &amp; DB|\n        :Cập nhật Trip COMPLETED\\nvà kết thúc DrivingSession;\n        |Lái xe (User)|\n        :Hiển thị \&quot;Chuyến đã hoàn thành\&quot;;\n        stop\n      endif\n    else (Không)\n      |App Lái xe (Flutter / SQLite)|\n      :Quay lại chế độ lái;\n    endif\n  endif\nrepeat while (Chuyến tiếp tục diễn ra)\n@enduml&quot;,
  &quot;config&quot;: null
}" id="0hwkKZOwayztivsvXmVL-76"><mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;fontStyle=1;" vertex="1"><mxGeometry height="2480" width="1467" as="geometry" /></mxCell></UserObject><UserObject label="Lái xe (User)" plantUmlId="lane_156" plantUmlBaseStyle="swimlane;collapsible=0;startSize=30;fillColor=#E8F5E9;swimlaneFillColor=#E8F5E9;strokeColor=#181818;strokeWidth=1.5;fontColor=#000000;fontSize=18;fontStyle=0;html=1;" plantUmlBaseValue="Lái xe (User)" id="0hwkKZOwayztivsvXmVL-77"><mxCell parent="0hwkKZOwayztivsvXmVL-76" style="swimlane;collapsible=0;startSize=30;fillColor=none;swimlaneFillColor=none;strokeColor=#000000;strokeWidth=1.5;fontColor=#000000;fontSize=18;fontStyle=1;html=1;" vertex="1"><mxGeometry height="2194" width="531" x="-320" y="16" as="geometry" /></mxCell></UserObject><UserObject label="" plantUmlId="start_0" plantUmlBaseStyle="ellipse;fillColor=#222222;strokeColor=#222222;" plantUmlBaseValue="" id="0hwkKZOwayztivsvXmVL-80"><mxCell parent="0hwkKZOwayztivsvXmVL-77" style="ellipse;fillColor=#000000;strokeColor=#000000;fontStyle=1;" vertex="1"><mxGeometry height="20" width="20" x="255.5" y="64" as="geometry" /></mxCell></UserObject><UserObject label="Lái xe mở chuyến" plantUmlId="action_2" plantUmlBaseStyle="rounded=1;absoluteArcSize=1;arcSize=25;fillColor=#F1F1F1;strokeColor=#181818;strokeWidth=0.5;whiteSpace=wrap;fontSize=12;align=left;spacingLeft=6;" plantUmlBaseValue="Mở chi tiết chuyến" id="0hwkKZOwayztivsvXmVL-82"><mxCell parent="0hwkKZOwayztivsvXmVL-77" style="rounded=1;absoluteArcSize=1;arcSize=25;fillColor=#ffffff;strokeColor=#000000;strokeWidth=0.5;whiteSpace=wrap;fontSize=12;align=left;spacingLeft=6;fontStyle=1;fontColor=#000000;" vertex="1"><mxGeometry height="36" width="122" x="204.5" y="104" as="geometry" /></mxCell></UserObject><UserObject label="" plantUmlId="e_1" plantUmlBaseStyle="endArrow=classic;endSize=8;strokeColor=#181818;" plantUmlBaseValue="" id="0hwkKZOwayztivsvXm