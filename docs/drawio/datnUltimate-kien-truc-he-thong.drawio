og" mermaidId="e:Drive-&gt;DB#2" mermaidBaseStyle="endArrow=block;endSize=9;verticalAlign=bottom;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=16;labelBackgroundColor=none;strokeWidth=1.5;strokeColor=light-dark(#333333,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;" mermaidBaseValue="DrivingSession FINISHED + DriverWorkLog" id="gf8HCPeMPUONSb7uqguL-82"><mxCell edge="1" parent="gf8HCPeMPUONSb7uqguL-1" source="gf8HCPeMPUONSb7uqguL-9" style="endArrow=block;endSize=9;verticalAlign=bottom;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=16;labelBackgroundColor=none;strokeWidth=1.5;strokeColor=light-dark(#333333,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;" target="gf8HCPeMPUONSb7uqguL-10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1801" y="1788" /></Array><mxPoint x="1630" y="1788" as="sourcePoint" /><mxPoint x="1972" y="1788" as="targetPoint" /></mxGeometry></mxCell></UserObject><mxCell id="gf8HCPeMPUONSb7uqguL-83" parent="gf8HCPeMPUONSb7uqguL-1" style="ellipse;aspect=fixed;fillColor=light-dark(#333333,#cccccc);align=center;verticalAlign=middle;fontColor=light-dark(#FFFFFF,#333333);fontSize=12;" value="34" vertex="1"><mxGeometry height="20" width="20" x="1620" y="1778" as="geometry" /></mxCell><UserObject label="Chuyến hoàn thành" mermaidId="e:API-&gt;App#1" mermaidBaseStyle="dashed=1;fixDash=1;dashPattern=3 3;endArrow=block;endSize=9;verticalAlign=bottom;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=16;labelBackgroundColor=none;strokeWidth=1.5;strokeColor=light-dark(#333333,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;" mermaidBaseValue="Chuyến hoàn thành" id="gf8HCPeMPUONSb7uqguL-84"><mxCell edge="1" parent="gf8HCPeMPUONSb7uqguL-1" source="gf8HCPeMPUONSb7uqguL-6" style="dashed=1;fixDash=1;dashPattern=3 3;endArrow=block;endSize=9;verticalAlign=bottom;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=16;labelBackgroundColor=none;strokeWidth=1.5;strokeColor=light-dark(#333333,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;" target="gf8HCPeMPUONSb7uqguL-3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="685" y="1832" /></Array><mxPoint x="1030" y="1832" as="sourcePoint" /><mxPoint x="339" y="1832" as="targetPoint" /></mxGeometry></mxCell></UserObject><mxCell id="gf8HCPeMPUONSb7uqguL-85" parent="gf8HCPeMPUONSb7uqguL-1" style="ellipse;aspect=fixed;fillColor=light-dark(#333333,#cccccc);align=center;verticalAlign=middle;fontColor=light-dark(#FFFFFF,#333333);fontSize=12;" value="35" vertex="1"><mxGeometry height="20" width="20" x="1020" y="1822" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="Sequence - Telemetry &amp; Map: Batch đẩy GPS Telemetry &amp; Cập nhật bản đồ qua STOMP" id="KquDZ8lGNlF7XVhtrhSe">
    
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><UserObject label="" mermaidData="{
  &quot;data&quot;: &quot;sequenceDiagram\n    autonumber\n    actor Driver as Lái xe\n    participant GPS as Android Geolocator\n    participant Tracker as VehicleLocationTracker\n    participant Queue as SQLite offline_queue\n    participant API as MobileController\n    participant Telemetry as TelemetryService\n    participant DB as MySQL\n    participant Broker as STOMP/WebSocket\n    participant Web as Next.js RealtimeContext\n    actor Manager as Quản lý\n\n    Driver-&gt;&gt;Tracker: Đăng nhập app\n    Tracker-&gt;&gt;GPS: Xin quyền và mở position stream\n    loop Khoảng 8–10 giây hoặc di chuyển &gt;= 5m\n        GPS--&gt;&gt;Tracker: Position(lat,lng,speed,heading,accuracy)\n        Tracker-&gt;&gt;Queue: Lưu TELEMETRY với clientEventId\n        alt Có mạng\n            Tracker-&gt;&gt;API: POST /mobile/telemetry/batch\n            API-&gt;&gt;Telemetry: ingestBatch()\n            Telemetry-&gt;&gt;DB: Tạo sync_batches/items và telemetry_logs\n            Telemetry-&gt;&gt;DB: Cập nhật Vehicle.lastLat/lastLng/lastSpeed\n            Telemetry-&gt;&gt;Broker: Publish vehicle position after commit\n            Broker--&gt;&gt;Web: /topic/vehicle-positions\n            Web--&gt;&gt;Manager: Di chuyển marker và cập nhật thời gian\n            API--&gt;&gt;Tracker: ACCEPTED hoặc DUPLICATE\n            Tracker-&gt;&gt;Queue: Mark SYNCED\n        else Mất mạng\n            Queue--&gt;&gt;Tracker: PENDING\n        end\n    end\n\n    alt WebSocket web gián đoạn\n        Web--&gt;&gt;Manager: Hiển thị Đang kết nối lại\n        Web-&gt;&gt;API: Poll REST vehicle positions\n        API-&gt;&gt;DB: Đọc vị trí cuối\n        DB--&gt;&gt;Web: Snapshot + lastUpdatedAt\n    end&quot;,
