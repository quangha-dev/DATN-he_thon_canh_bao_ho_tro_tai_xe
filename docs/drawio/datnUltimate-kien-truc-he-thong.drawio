»" plantUmlId="rel_12" plantUmlBaseStyle="endArrow=open;dashed=1;dashPattern=5 5;strokeColor=#181818;fontColor=#000000;fontSize=11;edgeStyle=none;rounded=0;html=1;" plantUmlBaseValue="«include»" id="hUZbojSCFpiBYg0G1eXS-16"><mxCell edge="1" parent="hUZbojSCFpiBYg0G1eXS-1" source="hUZbojSCFpiBYg0G1eXS-2" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;endArrow=open;endSize=8;strokeColor=light-dark(#4B5563,#9CA3AF);strokeWidth=1.2;fontSize=12;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontColor=light-dark(#333333,#cccccc);jumpStyle=arc;jumpSize=6;" target="hUZbojSCFpiBYg0G1eXS-13"><mxGeometry relative="1" as="geometry"><mxPoint x="680" y="287" as="sourcePoint" /><mxPoint x="570" y="260" as="targetPoint" /></mxGeometry></mxCell></UserObject><mxCell id="hUZbojSCFpiBYg0G1eXS-17" edge="1" parent="1" source="hUZbojSCFpiBYg0G1eXS-18" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;strokeColor=light-dark(#333333,#cccccc);strokeWidth=1.2;fontSize=12;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontColor=light-dark(#333333,#cccccc);jumpStyle=arc;jumpSize=6;" target="hUZbojSCFpiBYg0G1eXS-2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="hUZbojSCFpiBYg0G1eXS-18" parent="1" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;" value="&lt;b&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;Quản lí&lt;/font&gt;&lt;/b&gt;" vertex="1"><mxGeometry height="60" width="30" x="310" y="470" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="Activity - Auth: Đăng nhập, Làm mới Token &amp; Quản lý phiên dùng chung" id="xIHNoUCsM0Y8g3J8ZxbR"><mxGraphModel grid="1" page="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1654" pageHeight="2336" math="0" shadow="0"><root><mxCell id="0" style="fontStyle=1;" /><mxCell id="1" parent="0" style="fontStyle=1;" /><UserObject label="" plantUmlData="{
  &quot;data&quot;: &quot;@startuml\ntitle Biểu đồ hoạt động: A1 - Đăng nhập và quản lý phiên dùng chung\n\n|#E8F5E9| Lái xe / Quản lý (User) |\n|#E3F2FD| Frontend (App / Web) |\n|#FFF3E0| Backend Server |\n\n|Lái xe / Quản lý (User)|\nstart\n:Nhập tài khoản và mật khẩu;\n\n|Frontend (App / Web)|\n:Kiểm tra dữ liệu bắt buộc;\nif (Hợp lệ phía client?) then (Không)\n  :Hiển thị lỗi tại trường;\n  detach\nelse (Có)\n  :Gửi yêu cầu đăng nhập;\n  \n  |Backend Server|\n  :Xác thực tài khoản;\n  if (Backend xác thực thành công?) then (Không)\n    if (Lỗi loại nào?) then (401)\n      :Thông báo sai tài khoản hoặc mật khẩu;\n    else (Lỗi kết nối)\n      :Thông báo không thể kết nối máy chủ;\n      :Cho phép thử lại;\n    endif\n    detach\n  else (Có)\n    :Đọc hồ sơ và vai trò;\n    \n    |Frontend (App / Web)|\n    :Lưu access token và refresh token;\n    if (Actor?) then (Lái xe)\n      :Khởi động Driver Shell,\\nSyncQueue và GPS tracker;\n    else (Quản lý)\n      :Điều hướng tới trang\\nmặc định theo role;\n    endif\n    \n    |Lái xe / Quản lý (User)|\n    :Sử dụng hệ thống;\n    \n    |Frontend (App / Web)|\n    if (Access token hết hạn?) then (Có)\n      :Gửi yêu cầu Refresh token;\n      |Backend Server|\n      :Xử lý Refresh Token;\n      |Frontend (App / Web)|\n      if (Refresh thành công?) then (Có)\n        |Lái xe / Quản lý (User)|\n        :Tiếp tục sử dụng hệ thống;\n      else (Không)\n        :Xóa phiên và quay về đăng nhập;\n        |Lái xe / Quản lý (User)|\n        stop\n      endif\n    else (Không)\n      |Lái xe / Quản lý (User)|\n      :Tiếp tục sử dụng hệ thống;\n    endif\n  endif\nendif\n@enduml&quot;,
  &quot;config&quot;: null
