olor=light-dark(#333333,#cccccc);exitX=0.49;exitY=1;entryX=0.31;entryY=0;" mermaidBaseValue="" id="zgYr9PPkEtIWsYQB2ho7-386"><mxCell edge="1" parent="zgYr9PPkEtIWsYQB2ho7-195" source="zgYr9PPkEtIWsYQB2ho7-307" style="curved=1;startArrow=diamondThin;startSize=14;startFill=1;endArrow=none;exitX=0.49;exitY=1;entryX=0.31;entryY=0;rounded=0;" target="zgYr9PPkEtIWsYQB2ho7-309"><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell></UserObject><mxCell id="zgYr9PPkEtIWsYQB2ho7-387" parent="zgYr9PPkEtIWsYQB2ho7-386" style="edgeLabel;resizable=0;labelBackgroundColor=none;fontSize=11;spacing=8;align=right;verticalAlign=top;" value="1" vertex="1"><mxGeometry relative="1" x="-1" as="geometry" /></mxCell><mxCell id="zgYr9PPkEtIWsYQB2ho7-388" parent="zgYr9PPkEtIWsYQB2ho7-386" style="edgeLabel;resizable=0;labelBackgroundColor=none;fontSize=11;spacing=8;align=left;verticalAlign=bottom;" value="0..*" vertex="1"><mxGeometry relative="1" x="1" as="geometry" /></mxCell><UserObject label="" mermaidId="e:Trip-&gt;WarehouseIssueDocument#0" mermaidBaseStyle="curved=1;startArrow=none;endArrow=classic;endSize=9;strokeColor=light-dark(#333333,#cccccc);exitX=1;exitY=0.56;entryX=0.19;entryY=0;" mermaidBaseValue="" id="zgYr9PPkEtIWsYQB2ho7-389"><mxCell edge="1" parent="zgYr9PPkEtIWsYQB2ho7-195" source="zgYr9PPkEtIWsYQB2ho7-295" style="curved=1;startArrow=none;endArrow=classic;endSize=9;exitX=1;exitY=0.5;entryX=0.19;entryY=0;rounded=0;exitDx=0;exitDy=0;" target="zgYr9PPkEtIWsYQB2ho7-313"><mxGeometry relative="1" as="geometry"><Array as="points" /></mxGeometry></mxCell></UserObject><mxCell id="zgYr9PPkEtIWsYQB2ho7-390" parent="zgYr9PPkEtIWsYQB2ho7-389" style="edgeLabel;resizable=0;labelBackgroundColor=none;fontSize=11;spacing=8;align=left;verticalAlign=top;" value="0..1" vertex="1"><mxGeometry relative="1" x="-1" as="geometry"><mxPoint y="-6" as="offset" /></mxGeometry></mxCell><mxCell id="zgYr9PPkEtIWsYQB2ho7-391" parent="zgYr9PPkEtIWsYQB2ho7-389" style="edgeLabel;resizable=0;labelBackgroundColor=none;fontSize=11;spacing=8;align=right;verticalAlign=bottom;" value="0..1" vertex="1"><mxGeometry relative="1" x="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="Class - Mobile App: Cấu trúc tầng Presentation, Controller &amp; Repository (Flutter)" id="DiewJBDL0QzaGx9qMUds">
    
    <mxGraphModel grid="1" page="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1654" pageHeight="2336" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><UserObject label="" mermaidData="{
  &quot;data&quot;: &quot;classDiagram\n    class SafeFleetDriverApp {\n        +build()\n        +restoreSession()\n    }\n    class SessionController {\n        +restore()\n        +login()\n        +logout()\n    }\n    class DriverShell {\n        +selectPage()\n        +raiseSafetyAlert()\n    }\n    class ApiClient {\n        +initialize()\n        +login()\n        +get()\n        +post()\n        +patch()\n        +refreshAccessToken()\n    }\n    class DriverRepository {\n        +bootstrap()\n        +trip()\n        +workflow()\n        +navigationRoute()\n        +queueTelemetry()\n        +reportFlood()\n        +sendSos()\n        +agentChat()\n    }\n    class LocalDatabase {\n        +enqueue()\n        +pending()\n        +markSynced()\n        +cache()\n    }\n    class SyncQueue {\n        +enqueueTelemetry()\n        +enqueueSafety()\n        +enqueueSos()\n        +enqueueWorkflow()\n        +enqueueFlood()\n        +syncNow()\n    }\n    class VehicleLocationTracker {\n        +start()\n        +stop()\n        -publish()\n    }\n    class CabinSafetyController {\n        +start()\n        +stop()\n        +setModel()\n        +acknowledgeDetection()\n        +enterBackground()\n    }\n    class CabinAiController {\n        +start()\n        +stop()\n        +updateSpeed()\n        -processCameraImage()\n    }\n    class StgtDrowsinessEngine {\n        +initialize()\n        +observe()\n        +reset()\n    }\n    class TemporalSafetyEngine {\n        +observe()\n        +reset()\n    }\n    class AgentConversationController {\n        +listen()\n        +send()\n        +setWakeEnabled()\n    }\n    class DrivingLogRepository {\n        +save()\n        +find()\n        +list()\n        +markExported()\n    }\n    class DocumentScanService {\n        +process()\n        -recognizeBestOrientation()\n        -recognizeFocusedRegion()\n    }\n    class DocumentFieldExtractor {\n        +extract()\n        +normalizePlate()\n        +labelSimilarity()\n    }\n    class OnDeviceVietOcrService {\n        +recognizeLine()\n    }\n    class ServerDocumentOcrService {\n        +recognize()\n    }\n    class DrivingLogExportService {\n        +export()\n        +buildWorkbookBytes()\n    }\n    class DrivingLogEntry {\n        +missingFields\n        +totalCost\n        +hasRequiredOperationalFields\n    }\n\n    SafeFleetDriverApp --&gt; SessionController\n    SafeFleetDriverApp --&gt; DriverShell\n    SessionController --&gt; ApiClient\n    DriverShell --&gt; VehicleLocationTracker\n    DriverShell --&gt; CabinSafetyController\n    DriverShell --&gt; AgentConversationController\n    DriverRepository --&gt; ApiClient\n    DriverRepository --&gt; LocalDatabase\n    DriverRepository --&gt; SyncQueue\n    VehicleLocationTracker --&gt; DriverRepository\n    VehicleLocationTracker --&gt; SyncQueue\n    SyncQueue --&gt; LocalDatabase\n    SyncQueue --&gt; ApiClient\n    CabinSafetyController --&gt; CabinAiController\n    CabinSafetyController --&gt; DriverRepository\n    CabinAiController --&gt; StgtDrowsinessEngine\n    CabinAiController --&gt; TemporalSafetyEngine\n    AgentConversationController --&gt; DriverRepository\n    DrivingLogRepository --&gt; LocalDatabase\n    DrivingLogRepository --&gt; DrivingLogEntry\n    DocumentScanService --&gt; DocumentFieldExtractor\n    DocumentScanService --&gt; OnDeviceVietOcrService\n    DocumentScanService --&gt; DrivingLogEntry\n    ServerDocumentOcrService --&gt; ApiClient\n    DrivingLogExportService --&gt; DrivingLogEntry&quot;,
  &quot;config&quot;: null
}" id="y9xVV86LZtGSyZUJF5Mr-1"><mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1"><mxGeometry as="geometry" /></mxCell></UserObject><UserObject label="&lt;b&gt;SafeFleetDriverApp&lt;/b&gt;" mermaidId="n:SafeFleetDriverApp" mermaidBaseStyle="swimlane;html=1;fontStyle=0;fontSize=16;align=center;verticalAlign=middle;horizontal=1;childLayout=stackLayout;startSize=48;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginTop=12;marginBottom=12;stackSpacing=0;swimlaneFillColor=light-dark(#ECECFF,#1f2020);whiteSpace=wrap;fillColor=light-dark(#ECECFF,#1f2020);strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;" mermaidBaseValue="&lt;b&gt;SafeFleetDriverApp&lt;/b&gt;" id="y9xVV86LZtGSyZUJF5Mr-2"><mxCell parent="y9xVV86LZtGSyZUJF5Mr-1" style="swimlane;html=1;fontStyle=0;fontSize=16;align=center;verticalAlign=middle;horizontal=1;childLayout=stackLayout;startSize=48;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginTop=12;marginBottom=12;stackSpacing=0;swimlaneFillColor=light-dark(#FFFFFF,#1f2020);whiteSpace=wrap;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;strokeColor=default;fontColor=default;fillColor=default;" vertex="1"><mxGeometry height="140" width="216" x="20" y="60" as="geometry" /></mxCell></UserObject><mxCell id="y9xVV86LZtGSyZUJF5Mr-3" parent="y9xVV86LZtGSyZUJF5Mr-2" style="line;strokeWidth=1;spacingLeft=3;spacingRight=3;rotatable=0;points=[];" vertex="1"><mxGeometry height="20" width="216" y="60" as="geometry" /></mxCell><mxCell id="y9xVV86LZtGSyZUJF5Mr-4" parent="y9xVV86LZtGSyZUJF5Mr-2" style="text;fontSize=16;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;" value="+build()" vertex="1"><mxGeometry height="24" width