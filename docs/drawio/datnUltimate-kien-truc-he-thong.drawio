chuyến" id="_OThbNKAapRdDtflbr5w">
    
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><UserObject label="" mermaidData="{
  &quot;data&quot;: &quot;sequenceDiagram\n    autonumber\n    actor Driver as Lái xe\n    participant App as Flutter App\n    participant Repo as DriverRepository\n    participant Queue as SyncQueue/SQLite\n    participant API as MobileController\n    participant Mobile as MobileAppService\n    participant TripSvc as TripService\n    participant Drive as DrivingTimeService\n    participant DB as MySQL\n    participant WS as WebSocket\n\n    Driver-&gt;&gt;App: Mở chi tiết chuyến\n    App-&gt;&gt;Repo: trip(id)\n    Repo-&gt;&gt;API: GET /mobile/trips/{id}\n    API-&gt;&gt;DB: Đọc Trip + WarehouseIssue\n    DB--&gt;&gt;App: Chi tiết chuyến/chứng từ\n    Driver-&gt;&gt;App: Xác nhận 7 mục checklist\n    App-&gt;&gt;API: POST /pre-trip-checklist\n    API-&gt;&gt;DB: Lưu PreTripChecklist\n    DB--&gt;&gt;App: passed=true\n\n    App-&gt;&gt;Repo: workflow(start, clientEventId)\n    alt Online\n        Repo-&gt;&gt;API: POST /start-workflow\n        API-&gt;&gt;Mobile: startWorkflow()\n        Mobile-&gt;&gt;DB: Kiểm tra MobileCommandReceipt\n        Mobile-&gt;&gt;TripSvc: start(tripId)\n        TripSvc-&gt;&gt;DB: Trip IN_PROGRESS + TripTimeline\n        Mobile-&gt;&gt;Drive: start driving session\n        Drive-&gt;&gt;DB: Lưu DrivingSession ACTIVE\n        Mobile-&gt;&gt;DB: Lưu command receipt\n        Mobile-&gt;&gt;WS: Publish trip update\n        API--&gt;&gt;App: IN_PROGRESS\n    else Offline\n        Repo-&gt;&gt;Queue: enqueueWorkflow(start)\n        Queue--&gt;&gt;App: QUEUED_OFFLINE\n    end\n\n    Driver-&gt;&gt;App: Tạm nghỉ / tiếp tục\n    App-&gt;&gt;API: POST pause-workflow / resume-workflow\n    API-&gt;&gt;TripSvc: pause()/resume()\n    API-&gt;&gt;Drive: pause()/resume session\n    TripSvc-&gt;&gt;DB: Cập nhật Trip + timeline\n    Drive-&gt;&gt;DB: Cập nhật DrivingSession\n\n    Driver-&gt;&gt;App: Xác nhận hoàn thành\n    App-&gt;&gt;API: POST complete-workflow\n    API-&gt;&gt;TripSvc: complete()\n    TripSvc-&gt;&gt;DB: Trip COMPLETED + actual_end_time + timeline\n    API-&gt;&gt;Drive: finish session\n    Drive-&gt;&gt;DB: DrivingSession FINISHED + DriverWorkLog\n    API--&gt;&gt;App: Chuyến hoàn thành&quot;,
  &quot;config&quot;: null
}" id="gf8HCPeMPUONSb7uqguL-1"><mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1"><mxGeometry as="geometry" /></mxCell></UserObject><UserObject label="Lái xe" mermaidId="n:Driver" mermaidBaseStyle="html=1;shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;edgeStyle&quot;:&quot;elbowEdgeStyle&quot;,&quot;elbow&quot;:&quot;vertical&quot;,&quot;curved&quot;:0,&quot;rounded&quot;:0};lifelineDashed=0;strokeWidth=2;rounded=1;absoluteArcSize=1;arcSize=6;lifelineColor=light-dark(#9370DB,#cccccc);participant=seqActorStick;verticalAlign=bottom;align=center;spacingBottom=4;size=90;lifelineMirror=1;fillColor=light-dark(#ECECFF,#1f2020);strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="Lái xe" id="gf8HCPeMPUONSb7uqguL-2"><mxCell parent="gf8HCPeMPUONSb7uqguL-1" style="html=1;shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;edgeStyle&quot;:&quot;elbowEdgeStyle&quot;,&quot;elbow&quot;:&quot;vertical&quot;,&quot;curved&quot;:0,&quot;rounded&quot;:0};lifelineDashed=0;strokeWidth=2;rounded=1;absoluteArcSize=1;arcSize=6;lifelineColor=light-dark(#9370DB,#cccccc);participant=seqActorStick;verticalAlign=bottom;align=center;spacingBottom=4;size=90;lifelineMirror=1;fillColor=light-dark(#ECECFF,#1f2020);strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" vertex="1"><mxGeometry height="1912" width="150" x="30" y="30" as="geometry" /></mxCell></UserObject><UserObject label="Flutter App" mermaidId="n:App" mermaidBaseStyle="html=1;shape=umlLifeline;perimeter=lifelinePerimeter;