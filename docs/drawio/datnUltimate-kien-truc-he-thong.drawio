  &quot;data&quot;: &quot;erDiagram\n    USERS {\n        bigint id PK\n        varchar full_name\n    }\n    DRIVERS {\n        bigint id PK\n        varchar full_name\n    }\n    VEHICLES {\n        bigint id PK\n        varchar plate_number\n    }\n    TRIPS {\n        bigint id PK\n        varchar trip_code UK\n    }\n    WAREHOUSE_ISSUE_DOCUMENTS {\n        bigint id PK\n        bigint trip_id FK, UK\n        bigint prepared_by_user_id FK\n        bigint driver_id FK\n        bigint vehicle_id FK\n        varchar issue_number UK\n        date issue_date\n        varchar status\n        int document_version\n        varchar warehouse_name\n        varchar project_name\n        varchar recipient_name\n        datetime issued_at\n        datetime completed_at\n    }\n    WAREHOUSE_ISSUE_ITEMS {\n        bigint id PK\n        bigint document_id FK\n        int line_number\n        varchar item_code\n        varchar description\n        varchar unit\n        decimal requested_quantity\n        decimal issued_quantity\n        decimal returned_quantity\n        decimal delivered_quantity\n    }\n    WAREHOUSE_ISSUE_CONFIRMATIONS {\n        bigint id PK\n        bigint document_id FK\n        bigint created_by_user_id FK\n        varchar role_type\n        varchar status\n        varchar signer_name\n        datetime signed_at\n        double lat\n        double lng\n    }\n    WAREHOUSE_ISSUE_AUDIT_LOGS {\n        bigint id PK\n        bigint document_id FK\n        bigint actor_user_id FK\n        varchar action\n        varchar from_status\n        varchar to_status\n        datetime created_at\n    }\n\n    TRIPS o|--o| WAREHOUSE_ISSUE_DOCUMENTS : has\n    USERS o|--o{ WAREHOUSE_ISSUE_DOCUMENTS : prepares\n    DRIVERS o|--o{ WAREHOUSE_ISSUE_DOCUMENTS : delivers\n    VEHICLES o|--o{ WAREHOUSE_ISSUE_DOCUMENTS : transports\n    WAREHOUSE_ISSUE_DOCUMENTS ||--|{ WAREHOUSE_ISSUE_ITEMS : contains\n    WAREHOUSE_ISSUE_DOCUMENTS ||--o{ WAREHOUSE_ISSUE_CONFIRMATIONS : requires\n    WAREHOUSE_ISSUE_DOCUMENTS ||--o{ WAREHOUSE_ISSUE_AUDIT_LOGS : audits\n    USERS o|--o{ WAREHOUSE_ISSUE_CONFIRMATIONS : creates\n    USERS o|--o{ WAREHOUSE_ISSUE_AUDIT_LOGS : acts&quot;,
