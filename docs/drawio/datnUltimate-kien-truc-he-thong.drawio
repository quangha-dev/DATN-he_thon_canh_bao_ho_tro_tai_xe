<?xml version="1.0" encoding="utf-8"?><mxfile host="app.diagrams.net" pages="45"><diagram name="Use Case - Tổng quát toàn hệ thống SafeFleet" id="wYdgT0cJkoBF3LcC3gQb"><mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1654" pageHeight="2336" math="0" shadow="0"><root><mxCell id="0" style="fontStyle=1;" /><mxCell id="1" parent="0" style="fontStyle=1;" /><UserObject label="" plantUmlData="{
  &quot;data&quot;: &quot;@startuml
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle stickman

actor \&quot;Lái xe\&quot; as driver
actor \&quot;Quản lý\
(Admin/Manager/Dispatch/Safety)\&quot; as manager

rectangle \&quot;SafeFleet System\&quot; {
  usecase \&quot;D1. Xác thực &amp; Quản lý phiên\&quot; as D1
  usecase \&quot;D2. Quản lý &amp; Thực hiện chuyến\&quot; as D2
  usecase \&quot;D3. Dẫn đường &amp; Chia sẻ vị trí\&quot; as D3
  usecase \&quot;D4. Giám sát an toàn AI cabin\&quot; as D4
  usecase \&quot;D5. Báo cáo nguy hiểm &amp; SOS\&quot; as D5
  usecase \&quot;D6. Quản lý phiếu nhật trình OCR\&quot; as D6
  usecase \&quot;D7. Sử dụng trợ lý &amp; Xem thông tin\&quot; as D7

  usecase \&quot;M1. Xác thực &amp; Truy cập theo quyền\&quot; as M1
  usecase \&quot;M2. Giám sát vận hành Real-time\&quot; as M2
  usecase \&quot;M3. Điều phối &amp; Quản lý chuyến\&quot; as M3
  usecase \&quot;M4. Xử lý cảnh báo, sự cố &amp; ngập\&quot; as M4
  usecase \&quot;M5. Quản lý nguồn lực &amp; Cấu hình\&quot; as M5
  usecase \&quot;M6. Xem &amp; Xuất báo cáo\&quot; as M6
}

driver --&gt; D1
driver --&gt; D2
driver --&gt; D3
driver --&gt; D4
driver --&gt; D5
driver --&gt; D6
driver --&gt; D7

manager --&gt; M1
manager --&gt; M2
manager --&gt; M3
manager --&gt; M4
manager --&gt; M5
manager --&gt; M6
@enduml&quot;,
  &quot;config&quot;: null
