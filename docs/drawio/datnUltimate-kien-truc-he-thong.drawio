" /></mxCell><UserObject label="Poll REST vehicle positions" mermaidId="e:Web-&gt;API#0" mermaidBaseStyle="endArrow=block;endSize=9;verticalAlign=bottom;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=16;labelBackgroundColor=none;strokeWidth=1.5;strokeColor=light-dark(#333333,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;" mermaidBaseValue="Poll REST vehicle positions" id="Okdi9XSiEjpmKx7mfzjq-50"><mxCell edge="1" parent="Okdi9XSiEjpmKx7mfzjq-1" source="Okdi9XSiEjpmKx7mfzjq-10" style="endArrow=block;endSize=9;verticalAlign=bottom;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=16;labelBackgroundColor=none;strokeWidth=1.5;strokeColor=light-dark(#333333,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;" target="Okdi9XSiEjpmKx7mfzjq-6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1632" y="1088" /></Array><mxPoint x="2125" y="1088" as="sourcePoint" /><mxPoint x="1138" y="1088" as="targetPoint" /></mxGeometry></mxCell></UserObject><mxCell id="Okdi9XSiEjpmKx7mfzjq-51" parent="Okdi9XSiEjpmKx7mfzjq-1" style="ellipse;aspect=fixed;fillColor=light-dark(#333333,#cccccc);align=center;verticalAlign=middle;fontColor=light-dark(#FFFFFF,#333333);fontSize=12;" value="16" vertex="1"><mxGeometry height="20" width="20" x="2115" y="1078" as="geometry" /></mxCell><UserObject label="Đọc vị trí cuối" mermaidId="e:API-&gt;DB#0" mermaidBaseStyle="endArrow=block;endSize=9;verticalAlign=bottom;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=16;labelBackgroundColor=none;strokeWidth=1.5;strokeColor=light-dark(#333333,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;" mermaidBaseValue="Đọc vị trí cuối" id="Okdi9XSiEjpmKx7mfzjq-52"><mxCell edge="1" parent="Okdi9XSiEjpmKx7mfzjq-1" source="Okdi9XSiEjpmKx7mfzjq-6" style="endArrow=block;endSize=9;verticalAlign=bottom;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=16;labelBackgroundColor=none;strokeWidth=1.5;strokeColor=light-dark(#333333,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;" target="Okdi9XSiEjpmKx7mfzjq-8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1420" y="1142" /></Array><mxPoint x="1138" y="1142" as="sourcePoint" /><mxPoint x="1702" y="1142" as="targetPoint" /></mxGeometry></mxCell></UserObject><mxCell id="Okdi9XSiEjpmKx7mfzjq-53" parent="Okdi9XSiEjpmKx7mfzjq-1" style="ellipse;aspect=fixed;fillColor=light-dark(#333333,#cccccc);align=center;verticalAlign=middle;fontColor=light-dark(#FFFFFF,#333333);fontSize=12;" value="17" vertex="1"><mxGeometry height="20" width="20" x="1128" y="1132" as="geometry" /></mxCell><UserObject label="Snapshot + lastUpdatedAt" mermaidId="e:DB-&gt;Web#0" mermaidBaseStyle="dashed=1;fixDash=1;dashPattern=3 3;endArrow=block;endSize=9;verticalAlign=bottom;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=16;labelBackgroundColor=none;strokeWidth=1.5;strokeColor=light-dark(#333333,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;" mermaidBaseValue="Snapshot + lastUpdatedAt" id="Okdi9XSiEjpmKx7mfzjq-54"><mxCell edge="1" parent="Okdi9XSiEjpmKx7mfzjq-1" source="Okdi9XSiEjpmKx7mfzjq-8" style="dashed=1;fixDash=1;dashPattern=3 3;endArrow=block;endSize=9;verticalAlign=bottom;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=16;labelBackgroundColor=none;strokeWidth=1.5;strokeColor=light-dark(#333333,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;" target="Okdi9XSiEjpmKx7mfzjq-10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1914" y="1196" /></Array><mxPoint x="1702" y="1196" as="sourcePoint" /><mxPoint x="2125" y="1196" as="targetPoint" /></mxGeometry></mxCell></UserObject><mxCell id="Okdi9XSiEjpmKx7mfzjq-55" parent="Okdi9XSiEjpmKx7mfzjq-1" style="ellipse;aspect=fixed;fillColor=light-dark(#333333,#cccccc);align=center;verticalAlign=middle;fontColor=light-dark(#FFFFFF,#333333);fontSize=12;" value="18" vertex="1"><mxGeometry height="20" width="20" x="1692" y="1186" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="Sequence - Cabin AI &amp; Alerts: Trích xuất quan sát, Suy luận STGT &amp; Bắn cảnh báo Server" id="Emr64X7NJgO2XGRhZ7mB">
    
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><UserObject label="" mermaidData="{
  &quot;data&quot;: &quot;sequenceDiagram\n    autonumber\n    actor Driver as Lái xe\n    participant Camera as Camera trước\n    participant AI as CabinAiController\n    participant STGT as STGT TFLite\n    participant MLKit as ML Kit/Temporal Engine\n    participant App as CabinSafetyController\n    participant Queue as SyncQueue/SQLite\n    participant API as SafetyEvent API\n    participant Safety as SafetyEventService\n    participant DB as MySQL\n    participant WS as WebSocket\n    participant Web as Web quản lý\n    actor Manager as Quản lý\n\n    Driver-&gt;&gt;App: Bật giám sát\n    App-&gt;&gt;Camera: Khởi tạo camera và stream frame\n    App-&gt;&gt;AI: start(modelMode)\n    AI-&gt;&gt;STGT: Load drowsiness_model.tflite\n    loop Mỗi frame đủ điều kiện\n        Camera--&gt;&gt;AI: CameraImage\n        AI-&gt;&gt;MLKit: Face mesh/label extraction\n        MLKit--&gt;&gt;AI: EAR, MAR, iris, head pose, phone confidence\n        alt STGT sẵn sàng\n            AI-&gt;&gt;STGT: Suy luận chuỗi đặc trưng\n            STGT--&gt;&gt;AI: raw/smoothed/predicted risk\n        else STGT lỗi hoặc chọn temporal\n            AI-&gt;&gt;MLKit: Áp luật thời gian\n            MLKit--&gt;&gt;AI: Detection candidates\n        end\n        AI--&gt;&gt;App: CabinMetrics và SafetyDetection\n    end\n\n    alt HIGH hoặc CRITICAL\n        App--&gt;&gt;Driver: Banner/overlay + haptic\n        App-&gt;&gt;Queue: enqueueSafety(clientEventId)\n        Queue-&gt;&gt;API: POST /mobile/safety-events khi có mạng\n        API-&gt;&gt;Safety: create(event)\n        Safety-&gt;&gt;DB: Lưu SafetyEvent NEW\n        Safety-&gt;&gt;DB: Tạo Notification\n        Safety-&gt;&gt;WS: Publish safety event after commit\n        WS--&gt;&gt;Web: Cảnh báo mới\n        Web--&gt;&gt;Manager: Hàng đợi ưu tiên\n        Manager-&gt;&gt;Web: Acknowledge\n        Web-&gt;&gt;API: POST /safety-events/{id}/acknowledge\n        API-&gt;&gt;Safety: acknowledge(user)\n        Safety-&gt;&gt;DB: Cập nhật ACKNOWLEDGED, handled_by/at\n        opt Chuyển thành incident\n            Manager-&gt;&gt;Web: Create incident\n            Web-&gt;&gt;API: POST /safety-events/{id}/create-incident\n            Safety-&gt;&gt;DB: Tạo Incident và timeline\n        end\n        Manager-&gt;&gt;Web: Resolve/Dismiss\n        Web-&gt;&gt;API: POST resolve hoặc dismiss\n        API-&gt;&gt;DB: Cập nhật trạng thái cuối\n    end&quot;,
