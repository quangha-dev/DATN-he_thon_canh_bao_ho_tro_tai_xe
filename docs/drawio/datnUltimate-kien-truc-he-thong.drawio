1"><mxGeometry height="20" width="20" x="2557" y="1825" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="Sequence - Agent Assistant: Hội thoại Chat/STT, Phân loại Intent &amp; Xác nhận Token" id="IG_-w8b7kvbwxP-OhXO9">
    
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><UserObject label="" mermaidData="{
  &quot;data&quot;: &quot;sequenceDiagram\n    autonumber\n    actor Driver as Lái xe\n    participant App as Agent UI/Provider\n    participant STT as Speech-to-Text\n    participant TTS as Flutter TTS\n    participant API as MobileController\n    participant Chat as AgentConversationService\n    participant Intent as AgentIntentClassificationService\n    participant AI as AI Service\n    participant Mobile as MobileAppService\n    participant Domain as Trip/Incident/Flood Service\n    participant DB as MySQL\n\n    alt Nhập giọng nói\n        Driver-&gt;&gt;App: Bấm micro hoặc wake phrase\n        App-&gt;&gt;STT: listen vi-VN\n        STT--&gt;&gt;App: transcript\n    else Nhập văn bản\n        Driver-&gt;&gt;App: Nhập nội dung\n    end\n\n    alt Chat hỏi đáp\n        App-&gt;&gt;API: POST /mobile/agent/chat, tối đa 20 messages\n        API-&gt;&gt;Chat: respond(request)\n        alt AI service bật\n            Chat-&gt;&gt;AI: Gửi hội thoại\n            AI--&gt;&gt;Chat: responseText\n        else AI service tắt/lỗi\n            Chat--&gt;&gt;API: Phản hồi fallback an toàn\n        end\n        API--&gt;&gt;App: responseText\n        App-&gt;&gt;TTS: speak vi-VN\n    else Lệnh nghiệp vụ\n        App-&gt;&gt;API: POST /mobile/agent/command\n        API-&gt;&gt;Mobile: createAgentCommand()\n        Mobile-&gt;&gt;Intent: classify(transcript)\n        Intent-&gt;&gt;AI: Phân loại nếu bật\n        AI--&gt;&gt;Intent: intent + confidence\n        Intent--&gt;&gt;Mobile: Kết quả hoặc rule fallback\n        Mobile-&gt;&gt;DB: Lưu AgentCommand PENDING_CONFIRMATION\n        API--&gt;&gt;App: requiresConfirmation=true\n        App--&gt;&gt;Driver: Dialog xác nhận tác động\n        alt Hủy\n            App-&gt;&gt;API: POST /commands/{id}/cancel\n            API-&gt;&gt;DB: AgentCommand CANCELLED\n        else Xác nhận\n            App-&gt;&gt;API: POST /commands/{id}/confirm + GPS nếu cần\n            API-&gt;&gt;Mobile: confirmAgentCommand()\n            Mobile-&gt;&gt;Domain: Execute SOS/Flood/Trip workflow\n            Domain-&gt;&gt;DB: Lưu entity và timeline/receipt\n            Mobile-&gt;&gt;DB: AgentCommand EXECUTED + reference\n            API--&gt;&gt;App: responseText/result\n            App-&gt;&gt;TTS: speak(result)\n        end\n    end&quot;,
  &quot;config&quot;: null
}" id="8h3n7zgnn4nCcyGaA3BR-1"><mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1"><mxGeometry as="geometry" /></mxCell></UserObject><UserObject label="Lái xe" mermaidId="n:Driver" mermaidBaseStyle="html=1;shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;edgeStyle&quot;:&quot;elbowEdgeStyle&quot;,&quot;elbow&quot;:&quot;vertical&quot;,&quot;curved&quot;:0,&quot;rounded&quot;:0};lifelineDashed=0;strokeWidth=2;rounded=1;absoluteArcSize=1;arcSize=6;lifelineColor=light-dark(#9370DB,#cccccc);participant=seqActorStick;verticalAlign=bottom;align=center;spacingBottom=4;size=90;lifelineMirror=1;fillColor=light-dark(#ECECFF,#1f2020);strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="Lái xe" id="8h3n7zgnn4nCcyGaA3BR-2"><mxCell parent="8h3n7zgnn4nCcyGaA3BR-1" style="html=1;shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;container=1;dropTarget=0;collapsible=0;recursiveResize=0;outlineConnect=0;portConstraint=eastwest;newEdgeStyle={&quot;edgeStyle&quot;:&quot;elbowEdgeStyle&quot;,&quot;elbow&quot;:&quot;vertical&quot;,&quot;curved&quot;:0,&quot;rounded&quot;:0};lifelineDashed=0;strokeWidth=2;rounded=1;absoluteArcSize=1;arcSize=6;lifelineColor=light-dark(#9370DB,#cccccc);participant=seqActorStick;verticalAlign=bottom;align=center;spacingBottom=4;size=90;lifelineMirror=1;fillColor=light-dark(#ECECFF,#1f2020);strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" vertex="1"><mxGeometry height="2079" width="150" x="30" y="30" as="geometry" /></mxCell></UserObject><UserObject label="Agent UI/Provider" mermaidId="n:App" mermaidBaseStyle="html=1;shape=umlLifeline;perimeter=lifelinePeri