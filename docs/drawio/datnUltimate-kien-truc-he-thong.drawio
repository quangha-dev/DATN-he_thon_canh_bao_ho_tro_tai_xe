buồn ngủ STGT &amp; Cảnh báo an toàn" id="zAfKNTDFxQIcpt294CNx">
    
    <mxGraphModel grid="1" page="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1654" pageHeight="2336" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><UserObject label="" plantUmlData="{
  &quot;data&quot;: &quot;@startuml\ntitle Biểu đồ hoạt động: A5 - AI cabin và xử lý cảnh báo an toàn\n\n|#E3F2FD| Lái xe / App Mobile (AI Engine) |\n|#FFF3E0| Backend Server &amp; DB |\n|#E8F5E9| Quản lý (Web Dashboard) |\n\n|Lái xe / App Mobile (AI Engine)|\nstart\n:Lái xe bật giám sát cabin;\n\nif (Đã cấp quyền camera?) then (Không)\n  :Yêu cầu quyền camera và giải thích lý do;\n  stop\nelse (Có)\n  :Khởi động camera trước;\n  :Hiệu chuẩn khuôn mặt tài xế;\n  \n  if (Model STGT TFLite sẵn sàng?) then (Có)\n    :Suy luận STGT theo chuỗi frame;\n  else (Không)\n    :Dùng ML Kit và luật thời gian (Fallback);\n  endif\n  \n  repeat\n    :Tính EAR, MAR, Iris, Pitch/Yaw và Risk Score;\n    \n    if (Mức nguy cơ?) then (Bình thường)\n      :Tiếp tục đo, không tạo sự kiện;\n    else (Cấp 1 / Cấp 2)\n      if (Mức vi phạm?) then (Cấp 1 / HIGH)\n        :Hiển thị Banner cảnh báo + Rung vừa;\n      else (Cấp 2 / CRITICAL)\n        :Hiển thị Overlay toàn màn hình + Rung lặp;\n      endif\n      \n      :Tạo SafetyEvent local;\n      :Lưu vào Queue và thử đồng bộ lên Server;\n      \n      if (Server nhận thành công?) then (Chưa)\n        :Hiển thị \&quot;Đang chờ đồng bộ\&quot;;\n      else (Có)\n        |Backend Server &amp; DB|\n        :Lưu safety_events và phát WebSocket cảnh báo;\n        \n        |Quản lý (Web Dashboard)|\n        :Hiển thị cảnh báo trong hàng đợi ưu tiên;\n        :Quản lý xác nhận ACKNOWLEDGED;\n        \n        if (Cần escalated thành incident?) then (Có)\n          |Backend Server &amp; DB|\n          :Tạo Incident và khởi tạo Timeline;\n          \n          |Quản lý (Web Dashboard)|\n          :Theo dõi quy trình xử lý sự cố;\n          stop\n        else (Không)\n          |Quản lý (Web Dashboard)|\n          :Giải quyết hoặc bỏ qua sự cố (có lý do);\n          :SafetyEvent kết thúc;\n          stop\n        endif\n      endif\n    endif\n  repeat while (Tiếp tục giám sát cabin)\nendif\n@enduml&quot;,
  &quot;config&quot;: null
}" id="ZWK7oRfMKu4Ealat12uF-1"><mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1"><mxGeometry height="1730" width="1400" as="geometry" /></mxCell></UserObject><UserObject label="Lái xe / App Mobile (AI Engine)" plantUmlId="lane_111" plantUmlBaseStyle="swimlane;collapsible=0;startSize=30;fillColor=#E3F2FD;swimlaneFillColor=#E3F2FD;strokeColor=#181818;strokeWidth=1.5;fontColor=#000000;fontSize=18;fontStyle=0;html=1;" plantUmlBaseValue="Lái xe / App Mobile (AI Engine)" id="ZWK7oRfMKu4Ealat12uF-2"><mxCell parent="ZWK7oRfMKu4Ealat12uF-1" style="swimlane;collapsible=0;startSize=30;fillColor=#E3F2FD;swimlaneFillColor=#E3F2FD;strokeColor=#181818;strokeWidth=1.5;fontColor=#000000;fontSize=18;fontStyle=0;html=1;" vertex="1"><mxGeometry height="1690" width="601" x="-196.5" y="30" as="geometry" /></mxCell></UserObject><mxCell id="ZWK7oRfMKu4Ealat12uF-82" edge="1" parent="ZWK7oRfMKu4Ealat12uF-2" source="ZWK7oRfMKu4Ealat12uF-5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="ZWK7oRfMKu4Ealat12uF-7"><mxGeometry relative="1" as="geometry" /></mxCell><UserObject label="" plantUmlId="start_0" plantUmlBaseStyle="ellipse;fillColor=#222222;strokeColor=#222222;" plantUmlBaseValue="" id="ZWK7oRfMKu4Ealat12uF-5"><mxCell parent="ZWK7oRfMKu4Ealat12uF-2" style="ellipse;fillColor=#222222;strokeColor=#222222;" vertex="1"><mxGeometry height="20" width="20" x="293.5" y="52" as="geometry" /></mxCell></UserObject><mxCell id="ZWK7oRfMKu4Ealat12uF-83" edge="1" parent="ZWK7oRfMKu4Ealat12uF-2" source="ZWK7oRfMKu4Ealat12uF-7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" target="ZWK7oRfMKu4Ealat12uF-9"><mxGeometry relative="1" as="geometry" /></mxCell><UserObject label="Lái xe bật giám sát cabin" plantUmlId="action_2" plantUmlBaseStyle="rounded=1;absoluteArcSize=1;ar