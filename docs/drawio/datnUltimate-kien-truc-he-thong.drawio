  &quot;data&quot;: &quot;erDiagram\n    PERMISSIONS {\n        bigint id PK\n        varchar code UK\n        varchar description\n    }\n    ROLES {\n        bigint id PK\n        varchar name UK\n        varchar description\n    }\n    ROLE_PERMISSIONS {\n        bigint role_id PK, FK\n        bigint permission_id PK, FK\n    }\n    USERS {\n        bigint id PK\n        bigint role_id FK\n        varchar username UK\n        varchar email UK\n        varchar password_hash\n        varchar full_name\n        varchar status\n    }\n    DRIVERS {\n        bigint id PK\n        bigint user_id FK, UK\n        bigint current_vehicle_id FK\n        varchar license_number UK\n        varchar status\n        int safety_score\n        int continuous_driving_minutes\n    }\n    VEHICLES {\n        bigint id PK\n        bigint current_driver_id FK\n        bigint gps_device_id FK\n        bigint camera_device_id FK\n        varchar plate_number UK\n        varchar vehicle_type\n        varchar status\n        double last_lat\n        double last_lng\n    }\n    DEVICES {\n        bigint id PK\n        bigint vehicle_id FK\n        varchar device_code UK\n        varchar type\n        varchar status\n        datetime last_seen_at\n    }\n    DEVICE_CONNECTION_LOGS {\n        bigint id PK\n        bigint device_id FK\n        varchar status\n        double lat\n        double lng\n        datetime created_at\n    }\n    TRIPS {\n        bigint id PK\n        bigint vehicle_id FK\n        bigint driver_id FK\n        varchar trip_code UK\n        varchar start_location\n        varchar end_location\n        varchar status\n        int progress\n        varchar risk_level\n    }\n    TRIP_TIMELINES {\n        bigint id PK\n        bigint trip_id FK\n        bigint actor_id FK\n        varchar action\n        datetime created_at\n    }\n    PRE_TRIP_CHECKLISTS {\n        bigint id PK\n        bigint trip_id FK\n        bigint driver_id FK\n        bigint vehicle_id FK\n        boolean exterior_checked\n        boolean tires_checked\n        boolean brake_checked\n        boolean camera_checked\n    }\n    DRIVING_SESSIONS {\n        bigint id PK\n        bigint driver_id FK\n        bigint vehicle_id FK\n        bigint trip_id FK\n        varchar status\n        datetime started_at\n        int continuous_minutes\n        int total_minutes\n    }\n    DRIVER_WORK_LOGS {\n        bigint id PK\n        bigint driver_id FK\n        bigint trip_id FK\n        date work_date\n        int driving_minutes\n        int rest_minutes\n    }\n    TELEMETRY_LOGS {\n        bigint id PK\n        bigint vehicle_id FK\n        bigint driver_id FK\n        bigint trip_id FK\n        bigint sync_batch_id FK\n        varchar client_event_id\n        double lat\n        double lng\n        double speed\n        varchar gps_status\n    }\n    SAFETY_EVENTS {\n        bigint id PK\n        bigint vehicle_id FK\n        bigint driver_id FK\n        bigint trip_id FK\n        bigint handled_by FK\n        bigint sync_batch_id FK\n        varchar event_type\n        varchar severity\n        varchar status\n        double confidence\n    }\n    INCIDENTS {\n        bigint id PK\n        bigint vehicle_id FK\n        bigint driver_id FK\n        bigint trip_id FK\n        bigint assigned_to FK\n        bigint sync_batch_id FK\n        varchar incident_code UK\n        varchar type\n        varchar severity\n        varchar status\n    }\n    INCIDENT_TIMELINES {\n        bigint id PK\n        bigint incident_id FK\n        bigint actor_id FK\n        varchar action\n        varchar note\n        datetime created_at\n    }\n    FLOOD_REPORTS {\n        bigint id PK\n        bigint reported_by_driver_id FK\n        bigint verified_by FK\n        bigint sync_batch_id FK\n        double lat\n        double lng\n        varchar severity\n        varchar status\n        double confidence\n    }\n    MAINTENANCE_ORDERS {\n        bigint id PK\n        bigint vehicle_id FK\n        bigint assigned_to FK\n        varchar maintenance_code UK\n        varchar type\n        varchar priority\n        varchar status\n        decimal cost\n    }\n\n    ROLES ||--o{ USERS : has\n    ROLES ||--o{ ROLE_PERMISSIONS : maps\n    PERMISSIONS ||--o{ ROLE_PERMISSIONS : maps\n    USERS o|--o| DRIVERS : owns_profile\n    DRIVERS o|--o| VEHICLES : current_assignment\n    VEHICLES o|--o{ DEVICES : contains\n    DEVICES ||--o{ DEVICE_CONNECTION_LOGS : logs\n    DRIVERS o|--o{ TRIPS : performs\n    VEHICLES o|--o{ TRIPS : serves\n    TRIPS ||--o{ TRIP_TIMELINES : records\n    USERS o|--o{ TRIP_TIMELINES : acts\n    TRIPS ||--o{ PRE_TRIP_CHECKLISTS : requires\n    DRIVERS ||--o{ PRE_TRIP_CHECKLISTS : submits\n    VEHICLES o|--o{ PRE_TRIP_CHECKLISTS : checked_for\n    DRIVERS ||--o{ DRIVING_SESSIONS : drives\n    VEHICLES o|--o{ DRIVING_SESSIONS : uses\n    TRIPS o|--o{ DRIVING_SESSIONS : belongs_to\n    DRIVERS ||--o{ DRIVER_WORK_LOGS : summarizes\n    TRIPS o|--o{ DRIVER_WORK_LOGS : contributes\n    VEHICLES ||--o{ TELEMETRY_LOGS : emits\n    DRIVERS o|--o{ TELEMETRY_LOGS : sends\n    TRIPS o|--o{ TELEMETRY_LOGS : tracks\n    VEHICLES o|--o{ SAFETY_EVENTS : involved\n    DRIVERS o|--o{ SAFETY_EVENTS : triggers\n    TRIPS o|--o{ SAFETY_EVENTS : occurs_during\n    USERS o|--o{ SAFETY_EVENTS : handles\n    VEHICLES o|--o{ INCIDENTS : involved\n    DRIVERS o|--o{ INCIDENTS : reports\n    TRIPS o|--o{ INCIDENTS : occurs_during\n    USERS o|--o{ INCIDENTS : assigned\n    INCIDENTS ||--o{ INCIDENT_TIMELINES : records\n    USERS o|--o{ INCIDENT_TIMELINES : acts\n    DRIVERS o|--o{ FLOOD_REPORTS : reports\n    USERS o|--o{ FLOOD_REPORTS : verifies\n    VEHICLES ||--o{ MAINTENANCE_ORDERS : receives\n    USERS o|--o{ MAINTENANCE_ORDERS : assigned&quot;,
  &quot;config&quot;: null
