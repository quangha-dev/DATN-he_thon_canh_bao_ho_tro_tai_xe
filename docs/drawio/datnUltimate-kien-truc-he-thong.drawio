rebuchet MS,Verdana,Arial,sans-serif;" mermaidBaseValue="POST timeline / close" id="za78IYKDV7NlGrUbiI_p-66"><mxCell edge="1" parent="za78IYKDV7NlGrUbiI_p-1" source="za78IYKDV7NlGrUbiI_p-11" style="endArrow=block;endSize=9;verticalAlign=bottom;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=16;labelBackgroundColor=none;strokeWidth=1.5;strokeColor=light-dark(#333333,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;" target="za78IYKDV7NlGrUbiI_p-6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1700" y="1482" /></Array><mxPoint x="2283" y="1482" as="sourcePoint" /><mxPoint x="1117" y="1482" as="targetPoint" /></mxGeometry></mxCell></UserObject><mxCell id="za78IYKDV7NlGrUbiI_p-67" parent="za78IYKDV7NlGrUbiI_p-1" style="ellipse;aspect=fixed;fillColor=light-dark(#333333,#cccccc);align=center;verticalAlign=middle;fontColor=light-dark(#FFFFFF,#333333);fontSize=12;" value="25" vertex="1"><mxGeometry height="20" width="20" x="2273" y="1472" as="geometry" /></mxCell><UserObject label="Lưu timeline, resolved_at" mermaidId="e:API-&gt;DB#0" mermaidBaseStyle="endArrow=block;endSize=9;verticalAlign=bottom;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=16;labelBackgroundColor=none;strokeWidth=1.5;strokeColor=light-dark(#333333,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;" mermaidBaseValue="Lưu timeline, resolved_at" id="za78IYKDV7NlGrUbiI_p-68"><mxCell edge="1" parent="za78IYKDV7NlGrUbiI_p-1" source="za78IYKDV7NlGrUbiI_p-6" style="endArrow=block;endSize=9;verticalAlign=bottom;edgeStyle=elbowEdgeStyle;elbow=vertical;curved=0;rounded=0;fontSize=16;labelBackgroundColor=none;strokeWidth=1.5;strokeColor=light-dark(#333333,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;" target="za78IYKDV7NlGrUbiI_p-8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1372" y="1526" /></Array><mxPoint x="1117" y="1526" as="sourcePoint" /><mxPoint x="1627" y="1526" as="targetPoint" /></mxGeometry></mxCell></UserObject><mxCell id="za78IYKDV7NlGrUbiI_p-69" parent="za78IYKDV7NlGrUbiI_p-1" style="ellipse;aspect=fixed;fillColor=light-dark(#333333,#cccccc);align=center;verticalAlign=middle;fontColor=light-dark(#FFFFFF,#333333);fontSize=12;" value="26" vertex="1"><mxGeometry height="20" width="20" x="1107" y="1516" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="Sequence - Flood Scoring &amp; Reroute: Báo ngập, Tính điểm phạt tuyến &amp; Điều hướng lại" id="50vWoNiomHTnyg22OqRe">
    
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><UserObject label="" mermaidData="{
  &quot;data&quot;: &quot;sequenceDiagram\n    autonumber\n    actor Driver as Lái xe\n    participant App as Flutter App\n    participant GPS as Geolocator\n    participant Queue as SyncQueue\n    participant FloodAPI as Flood/Mobile Controller\n    participant Flood as FloodReportService\n    participant NavAPI as MobileNavigationController\n    participant Nav as NavigationService\n    participant Router as RoutingProvider\n    participant DB as MySQL\n    participant WS as WebSocket\n    participant Web as Flood Map\n    actor Manager as Quản lý\n\n    Driver-&gt;&gt;App: Chọn mức ngập và giữ để gửi\n    App-&gt;&gt;GPS: Lấy vị trí\n    GPS--&gt;&gt;App: lat,lng\n    alt Online\n        App-&gt;&gt;FloodAPI: POST /mobile/flood-reports/quick\n        FloodAPI-&gt;&gt;Flood: create()\n        Flood-&gt;&gt;DB: Lưu FloodReport UNVERIFIED\n        Flood-&gt;&gt;WS: Publish flood report\n        WS--&gt;&gt;Web: Điểm ngập mới\n    else Offline\n        App-&gt;&gt;Queue: enqueueFlood()\n        Queue-&gt;&gt;FloodAPI: Gửi lại khi có mạng\n    end\n\n    Manager-&gt;&gt;Web: Verify/Resolve\n    Web-&gt;&gt;FloodAPI: POST /flood-reports/{id}/verify hoặc resolve\n    FloodAPI-&gt;&gt;Flood: Cập nhật status, verifier, time\n    Flood-&gt;&gt;DB: Save\n\n    Driver-&gt;&gt;App: Tìm tuyến\n    App-&gt;&gt;NavAPI: POST /mobile/navigation/routes\n    NavAPI-&gt;&gt;Nav: createRoutes(origin,destination,trip)\n    Nav-&gt;&gt;Router: Lấy các route geometry\n    Router--&gt;&gt;Nav: Candidates\n    Nav-&gt;&gt;DB: Đọc flood VERIFIED/active gần tuyến\n    Nav-&gt;&gt;Nav: Tính floodPenalty, driverTimePenalty, restrictions, totalScore\n    Nav-&gt;&gt;DB: Lưu NavigationSession + RouteCandidates + selectedCandidate\n    NavAPI--&gt;&gt;App: Route được chọn, warnings, steps\n\n    loop Trong chế độ lái\n        App-&gt;&gt;NavAPI: POST /navigation/events\n        NavAPI-&gt;&gt;DB: Lưu NavigationEvent\n        NavAPI--&gt;&gt;App: rerouteRequired true/false\n        opt Cần reroute\n            App-&gt;&gt;NavAPI: POST /navigation/reroute\n            NavAPI-&gt;&gt;Nav: Re-score từ vị trí hiện tại\n            Nav--&gt;&gt;App: NavigationRoute mới\n        end\n    end&quot;,
  &quot;config&quot;: null
