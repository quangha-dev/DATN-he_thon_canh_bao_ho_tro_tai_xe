POSTGRES_DB=safefleet
POSTGRES_USER=safefleet
POSTGRES_PASSWORD=change_me_app_password
POSTGRES_PORT=5432
INFRA_BIND_ADDRESS=127.0.0.1

BACKEND_PORT=8080
FRONTEND_PORT=3000
AI_SERVICE_PORT=8000
AI_SERVICE_ENABLED=true
AI_SERVICE_URL=http://ai-service:8000
RAG_ENABLED=true
RAG_EMBEDDING_MODEL=intfloat/multilingual-e5-small
MCP_TIMEOUT_SECONDS=60

JWT_SECRET=change_me_to_at_least_32_random_characters
JWT_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=30
OPENAPI_PUBLIC_ENABLED=false
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:3100,http://127.0.0.1:3100

# Production ưu tiên cấu hình OpenAI từ .env. Không commit key thật.
OPENAI_API_KEY=
OPENAI_ENABLED=false
AGENT_MAX_STEPS=6
# Điền đơn giá hiện hành để runMetrics/evaluator ước tính chi phí; để trống nếu chỉ đo token.
OPENAI_INPUT_COST_PER_MILLION_USD=
OPENAI_OUTPUT_COST_PER_MILLION_USD=
AGENT_ENCRYPTION_SECRET=change_me_to_an_independent_32_character_secret
AI_INTERNAL_TOKEN=change_me_to_a_long_random_internal_service_token

FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_API_KEY=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_ANDROID_APP_ID=
FIREBASE_IOS_APP_ID=

MINIO_ROOT_USER=change_me_minio_user
MINIO_ROOT_PASSWORD=change_me_minio_password
MINIO_BUCKET=safefleet-evidence
EVIDENCE_STORAGE_PROVIDER=minio
EVIDENCE_MAX_SIZE_BYTES=8388608
SAFETY_EVENT_COOLDOWN_SECONDS=30
SOS_COOLDOWN_SECONDS=30
FCM_ENABLED=false
FCM_CREDENTIALS_PATH=
PUSH_DISPATCH_INTERVAL_MS=30000
PUSH_MAX_ATTEMPTS=6
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

REDIS_ENABLED=false
REDIS_PASSWORD=

PHOTON_URL=https://photon.komoot.io/api/

# --- Dẫn đường -------------------------------------------------------------
# Valhalla tự host là road graph chính thức. Chỉ Valhalla mới nhận được vùng
# cấm động (exclude_locations / exclude_polygons) do tài xế báo ngập, và chỉ
# Valhalla mới áp được giới hạn cao/rộng/dài/tải của xe. Bật bằng:
#   docker compose -f docker-compose.yml -f docker-compose.routing.yml up -d
VALHALLA_URL=http://valhalla:8002
VALHALLA_COSTING=truck

# OSRM chỉ là chế độ suy giảm khi Valhalla chết: profile xe con, KHÔNG áp được
# vùng cấm. Tuyến sinh ra được đánh dấu providerFallback=true và app hiển thị
# nhãn "Tuyến suy giảm"; backend vẫn tự loại tuyến cắt vùng chặn cứng.
# Máy chủ demo công cộng dưới đây không dùng cho production.
OSRM_URL=https://router.project-osrm.org/route/v1/driving

# Đường thẳng giả chỉ dành cho test cô lập. Không bao giờ bật ở môi trường thật.
ALLOW_DETERMINISTIC_ROUTING_FALLBACK=false

MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# Raster tile cho bản đồ web quản lý (không phải API key).
NEXT_PUBLIC_MAP_TILE_URL=https://a.basemaps.cartocdn.com/light_all/{z}/{x}/{y}.png

# Dẫn đường KHÔNG dùng Google. Key dưới đây chỉ phục vụ gợi ý địa điểm
# (Places API New); để trống thì hệ thống dùng Photon rồi tới danh mục nội bộ.
GOOGLE_MAPS_SERVER_API_KEY=

SEED_ENABLED=false
HANOI_DEMO_DATA_ENABLED=false
APP_LOG_LEVEL=INFO
